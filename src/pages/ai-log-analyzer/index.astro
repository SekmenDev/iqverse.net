---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const SAMPLE_LOG = `192.168.1.10 - - [15/Jan/2026:10:14:32 +0000] "GET /robots.txt HTTP/1.1" 200 412 "-" "Mozilla/5.0 (compatible; GPTBot/1.2; +https://openai.com/gptbot)"
192.168.1.11 - - [15/Jan/2026:10:15:01 +0000] "GET /llms.txt HTTP/1.1" 200 1024 "-" "Mozilla/5.0 (compatible; ClaudeBot/1.0; +https://anthropic.com/claudebot)"
192.168.1.12 - - [15/Jan/2026:10:16:45 +0000] "GET /blog/ai-trends HTTP/1.1" 200 4520 "-" "PerplexityBot/1.0 (+https://perplexity.ai/perplexitybot)"
192.168.1.13 - - [15/Jan/2026:10:17:10 +0000] "GET /docs/api HTTP/1.1" 404 210 "-" "Mozilla/5.0 (compatible; Bytespider; spider-feedback@bytedance.com)"
192.168.1.14 - - [15/Jan/2026:10:18:22 +0000] "GET /agentscan/ HTTP/1.1" 200 8920 "-" "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
192.168.1.15 - - [15/Jan/2026:10:19:00 +0000] "GET /sitemap.xml HTTP/1.1" 200 1540 "-" "Google-Extended/1.0"
192.168.1.10 - - [15/Jan/2026:10:20:15 +0000] "GET /blog/ai-trends HTTP/1.1" 200 4520 "-" "Mozilla/5.0 (compatible; GPTBot/1.2; +https://openai.com/gptbot)"`;
---

<ToolLayout
  title="AI Crawler Log Analyzer"
  subtitle="Detect & Inspect AI Crawler Visits"
  pill="AI & AGENTS"
  toolSlug="ai-log-analyzer"
  description="Parse server access logs in your browser to analyze visits from AI crawlers like GPTBot, ClaudeBot and PerplexityBot with zero data upload."
>
  <div style="max-width: 1050px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="logInput">
            Paste Nginx / Apache / Cloudflare Server Access Logs (Processed 100% Client-Side)
          </label>
          <textarea
            id="logInput"
            class={sharedStyles.textarea}
            rows="8"
            style="font-family: monospace; font-size: 0.8rem;"
          >{SAMPLE_LOG}</textarea>
        </div>

        <div style="margin-top: 12px; display: flex; gap: 10px;">
          <button
            type="button"
            id="btn-parse-logs"
            class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
          >
            Analyze AI Bot Visits
          </button>
        </div>

        <div id="log-results-container" style="margin-top: 24px; display: none;"></div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { parseAccessLogs, type AiLogHit } from '@/lib/ai-log';

  const logInput = document.getElementById('logInput') as HTMLTextAreaElement;
  const btnParse = document.getElementById('btn-parse-logs');
  const resultsContainer = document.getElementById('log-results-container');

  let parsedHits: AiLogHit[] = [];
  let activeBotFilter = 'all';

  function parseLogs() {
    if (!logInput || !resultsContainer) return;
    const content = logInput.value;
    const { totalLines, aiHitsCount, botCounts, topPaths, hits } = parseAccessLogs(content);

    parsedHits = hits;
    resultsContainer.style.display = 'block';

    resultsContainer.innerHTML = `
      <!-- Stats Overview -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="padding: 16px; border-radius: 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
          <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Total Log Lines</div>
          <div style="font-size: 1.8rem; font-weight: bold; margin-top: 4px;">${totalLines}</div>
        </div>

        <div style="padding: 16px; border-radius: 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
          <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">AI Crawler Hits</div>
          <div style="font-size: 1.8rem; font-weight: bold; margin-top: 4px; color: var(--accent);">${aiHitsCount}</div>
        </div>

        <div style="padding: 16px; border-radius: 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
          <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Unique AI Bots</div>
          <div style="font-size: 1.8rem; font-weight: bold; margin-top: 4px; color: var(--green);">${Object.keys(botCounts).length}</div>
        </div>
      </div>

      <!-- Bots Breakdown (Clickable Filter Cards) -->
      <div style="margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h4 style="margin: 0;">Detected AI Crawlers (Click to Filter)</h4>
          <button type="button" id="btn-show-all-bots" class="filter-pill active log-filter-btn" data-bot="all">
            Show All Bots <span class="filter-badge">${hits.length}</span>
          </button>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
          ${Object.entries(botCounts)
            .map(
              ([name, data]) => `
            <button type="button" class="stat-filter-card log-filter-btn" data-bot="${name}" style="padding: 12px 14px;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 0.95rem;">${name}</strong>
                <span class="filter-badge" style="background: rgba(129, 140, 248, 0.18); color: var(--accent);">${data.count} hits</span>
              </div>
              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">Vendor: ${data.vendor}</div>
            </button>
          `
            )
            .join('')}
        </div>
      </div>

      <!-- Top Crawled Paths -->
      <div style="margin-bottom: 28px;">
        <h4 style="margin-bottom: 12px;">Top AI Crawled Paths</h4>
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border); border-radius: 8px; overflow: hidden;">
          ${topPaths
            .map(
              (p) => `
            <div style="padding: 10px 16px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.85rem;">
              <span>${p.path}</span>
              <span style="font-weight: bold; color: var(--accent);">${p.count} requests</span>
            </div>
          `
            )
            .join('')}
        </div>
      </div>

      <!-- All AI Crawler Requests Table with Search Toolbar -->
      <div>
        <div class="tool-filter-bar" style="margin-top: 0; margin-bottom: 10px;">
          <div class="table-results-counter" style="margin: 0;">
            <span>Showing <strong id="log-visible-count">${hits.length}</strong> of <span>${hits.length}</span> requests</span>
          </div>

          <div class="search-input-wrap" style="max-width: 380px;">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              id="log-search-input"
              type="text"
              class="tool-search-input"
              placeholder="Search path, bot, status..."
            />
            <button type="button" id="btn-clear-log-search" class="search-clear-btn" title="Clear search">✕</button>
          </div>
        </div>

        <div id="log-table-wrap" class="results-table-container">
          <table class="results-table">
            <thead>
              <tr>
                <th style="width: 130px;">Crawler Bot</th>
                <th style="width: 80px;">Status</th>
                <th>Requested Path</th>
                <th>User-Agent / Signature</th>
              </tr>
            </thead>
            <tbody id="log-tbody"></tbody>
          </table>
        </div>

        <div id="log-empty-state" class="tool-empty-state" style="display: none;">
          <div class="tool-empty-state-icon">🔍</div>
          <div class="tool-empty-state-title">No matching log requests</div>
          <div class="tool-empty-state-text">No crawler visits match the active bot filter and search keyword.</div>
        </div>
      </div>
    `;

    attachLogEvents();
    renderLogTable();
  }

  function attachLogEvents() {
    const filterBtns = resultsContainer?.querySelectorAll('.log-filter-btn');
    const searchInput = document.getElementById('log-search-input') as HTMLInputElement;
    const btnClearSearch = document.getElementById('btn-clear-log-search');

    filterBtns?.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeBotFilter = (btn as HTMLElement).dataset.bot || 'all';
        renderLogTable();
      });
    });

    searchInput?.addEventListener('input', () => {
      if (btnClearSearch) btnClearSearch.style.display = searchInput.value ? 'inline-block' : 'none';
      renderLogTable();
    });

    btnClearSearch?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        btnClearSearch.style.display = 'none';
        renderLogTable();
        searchInput.focus();
      }
    });
  }

  function renderLogTable() {
    const tbody = document.getElementById('log-tbody');
    const searchInput = document.getElementById('log-search-input') as HTMLInputElement;
    const visibleCountEl = document.getElementById('log-visible-count');
    const tableWrap = document.getElementById('log-table-wrap');
    const emptyState = document.getElementById('log-empty-state');

    if (!tbody) return;
    const query = (searchInput?.value || '').toLowerCase().trim();

    const filtered = parsedHits.filter((item) => {
      if (activeBotFilter !== 'all' && item.botMatch.name !== activeBotFilter) return false;
      if (query) {
        const matchesPath = item.path.toLowerCase().includes(query);
        const matchesBot = item.botMatch.name.toLowerCase().includes(query);
        const matchesVendor = item.botMatch.vendor.toLowerCase().includes(query);
        const matchesUa = item.userAgent.toLowerCase().includes(query);
        const matchesStatus = item.status.includes(query);
        if (!matchesPath && !matchesBot && !matchesVendor && !matchesUa && !matchesStatus) {
          return false;
        }
      }
      return true;
    });

    if (visibleCountEl) visibleCountEl.textContent = String(filtered.length);

    if (filtered.length === 0 && parsedHits.length > 0) {
      if (tableWrap) tableWrap.style.display = 'none';
      if (emptyState) emptyState.style.display = 'flex';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';
    if (tableWrap) tableWrap.style.display = 'block';

    tbody.innerHTML = filtered
      .map((item) => {
        const statusNum = parseInt(item.status, 10);
        const isOk = statusNum >= 200 && statusNum < 300;
        const color = isOk ? 'var(--green)' : statusNum >= 400 ? 'var(--red)' : 'var(--accent)';
        const bg = isOk ? 'rgba(52, 211, 153, 0.12)' : statusNum >= 400 ? 'rgba(248, 113, 113, 0.12)' : 'rgba(129, 140, 248, 0.12)';

        return `
        <tr>
          <td>
            <span style="display: inline-block; padding: 3px 8px; border-radius: 6px; font-weight: 600; font-size: 0.8rem; background: rgba(129, 140, 248, 0.15); color: var(--accent);">
              ${item.botMatch.name}
            </span>
          </td>
          <td>
            <span style="display: inline-block; padding: 2px 6px; border-radius: 4px; font-weight: 700; font-family: var(--font-mono); font-size: 0.75rem; background: ${bg}; color: ${color};">
              ${item.status}
            </span>
          </td>
          <td style="font-family: var(--font-mono); font-weight: 600; font-size: 0.85rem; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            ${item.path}
          </td>
          <td style="font-family: var(--font-mono); color: var(--text-muted); font-size: 0.78rem; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            ${item.userAgent}
          </td>
        </tr>
      `;
      })
      .join('');
  }

  btnParse?.addEventListener('click', parseLogs);
  parseLogs();
</script>
