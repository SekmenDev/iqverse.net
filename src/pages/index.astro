---
import Layout from '@/layouts/Layout.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import ToolNavSearch from '@/components/ToolNavSearch.astro';
import { tools, getUniqueCategories, getUniqueStatuses } from '@/lib/tools';
import { getToolsCollectionJsonLd } from '@/lib/jsonld';
import styles from '@/styles/catalog.module.css';

const categories = getUniqueCategories();
const statuses = getUniqueStatuses();

const catCounts: Record<string, number> = { all: tools.length };
categories.forEach(cat => {
  if (cat !== 'all') {
    catCounts[cat] = tools.filter(t => t.cat === cat).length;
  }
});

const statusCounts: Record<string, number> = { all: tools.length };
statuses.forEach(s => {
  if (s !== 'all') {
    statusCounts[s] = tools.filter(t => t.type === s).length;
  }
});

const CAT_ICONS: Record<string, string> = {
  'AI & Agents': '🤖',
  'Browser Tools': '🧰',
  'Security': '🔒',
  'Design': '🎨',
  'Network': '🌐',
  'Desktop': '🖥️',
  'SaaS': '☁️',
};

const STATUS_ICONS: Record<string, string> = { open: '✦', saas: '◈', coming: '◌' };
const STATUS_LABELS: Record<string, string> = { open: 'Open Source', saas: 'SaaS', coming: 'Coming Soon' };
const DOT_CLASS: Record<string, string> = { open: styles.dotOpen, saas: styles.dotSaas, coming: styles.dotComing };

const groupedTools: Record<string, typeof tools> = {};
tools.forEach(t => {
  if (!groupedTools[t.cat]) groupedTools[t.cat] = [];
  groupedTools[t.cat].push(t);
});

const jsonLdData = getToolsCollectionJsonLd();
---

<Layout
  title="IQVerse | Free Open-Source Online Developer Tools & Utilities"
  description="IQVerse offers free, open-source browser-based developer tools for AI agent scanning, QR generation, link checking, favicon creation, JSON validation, CSS conversion, image optimization and more. All running locally in your browser with no login, no telemetry and no cost."
  canonicalUrl="https://iqverse.net/"
  jsonLd={jsonLdData}
>
  <div class={styles.container}>
    <!-- TOP NAV -->
    <nav class={styles.topNav}>
      <button
        type="button"
        id="menu-toggle-btn"
        class={styles.menuToggle}
        aria-label="Toggle menu"
      >
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 5h14M3 10h14M3 15h14" />
        </svg>
      </button>

      <a href="/" class={styles.navLogo}>
        <ThemeToggle />
        <span>IQVerse</span>
      </a>

      <ToolNavSearch />

      <div class={styles.navRight}>
        <a
          href="https://github.com/SekmenDev/iqverse.net"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          GitHub
        </a>
      </div>
    </nav>

    <button type="button" id="sidebar-overlay" class={styles.sidebarOverlay} aria-hidden="true" />

    <div class={styles.layout}>
      <!-- SIDEBAR -->
      <nav class={styles.sidebar} id="sidebar" aria-label="Tool categories">
        <span class={styles.sidebarLabel}>Categories</span>
        <div id="cat-filters">
          {categories.map(cat => (
            <button
              type="button"
              class={styles.catBtn}
              data-cat={cat}
              aria-pressed={cat === 'all' ? 'true' : 'false'}
            >
              <span class={styles.catIcon}>{cat === 'all' ? '⊞' : (CAT_ICONS[cat] || '○')}</span>
              <span style="flex: 1; text-align: left;">{cat === 'all' ? 'All Tools' : cat}</span>
              <span class={styles.catCount}>{catCounts[cat]}</span>
            </button>
          ))}
        </div>

        <span class={styles.sidebarLabel}>Status</span>
        <div id="status-filters">
          {statuses.map(s => (
            <button
              type="button"
              class={styles.catBtn}
              data-status={s}
              aria-pressed={s === 'all' ? 'true' : 'false'}
            >
              <span
                class={`${styles.catIcon} ${s !== 'all' ? DOT_CLASS[s] : ''}`}
              >
                {s === 'all' ? '⊞' : STATUS_ICONS[s]}
              </span>
              <span style="flex: 1; text-align: left;">{s === 'all' ? 'All' : STATUS_LABELS[s]}</span>
              <span class={styles.catCount}>{statusCounts[s]}</span>
            </button>
          ))}
        </div>
      </nav>

      <!-- MAIN -->
      <main class={styles.main} id="main-content">
        <h1 class="sr-only">IQVerse Developer Tools & Utilities</h1>
        <div class={styles.toolbar}>
          <span class={styles.resultCount} id="result-count">
            <strong>{tools.length}</strong> tools
          </span>
          <div class={styles.sortWrap} id="sort-filters" aria-label="Sort options">
            <button
              type="button"
              id="sort-default-btn"
              class={styles.sortBtn}
              data-sort="default"
              aria-pressed="true"
            >
              Default
            </button>
            <button
              type="button"
              id="sort-az-btn"
              class={styles.sortBtn}
              data-sort="az"
              aria-pressed="false"
            >
              A-Z
            </button>
          </div>
        </div>

        <div id="content-area">
          <div id="category-groups-container">
            {Object.entries(groupedTools).map(([cat, catTools]) => (
              <div class="category-group" data-group-cat={cat}>
                <p class={styles.sectionHead}>
                  {CAT_ICONS[cat] || ''} {cat}
                </p>
                <div class={`card-grid-container ${styles.cardGrid}`}>
                  {catTools.map(tool => {
                    const coming = tool.type === 'coming';
                    const href = tool.url && !coming ? tool.url : '';
                    const isExternalLink = !!href && /^(https?:\/\/|mailto:)/i.test(href);

                    return (
                      <div
                        class={`tool-card-item ${styles.cardLink}`}
                        data-name={tool.name}
                        data-desc={tool.desc}
                        data-tags={tool.tags}
                        data-cat={tool.cat}
                        data-type={tool.type}
                      >
                        {href && !coming ? (
                          <a
                            href={href}
                            class={`${styles.card} ${coming ? styles.cardComing : ''}`}
                            {...(isExternalLink ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                          >
                            <div class={styles.cardTop}>
                              <div class={styles.cardIcon}>
                                <span>{tool.icon}</span>
                              </div>
                              <div class={styles.cardStatus}>
                                <span class={`${styles.statusLabel} ${DOT_CLASS[tool.type]}`}>
                                  {STATUS_LABELS[tool.type]}
                                </span>
                              </div>
                            </div>
                            <div class={styles.cardName}>{tool.name}</div>
                            <p class={styles.cardDesc}>{tool.desc}</p>
                            <div class={styles.cardFooter}>
                              <div class={styles.cardTags}>
                                {tool.tags.split(' ').slice(0, 3).map(tag => (
                                  <span class={styles.tag}>{tag}</span>
                                ))}
                              </div>
                              <span class={styles.cardArrow} aria-hidden="true">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M3 8h10M8 3l5 5-5 5" />
                                </svg>
                              </span>
                            </div>
                          </a>
                        ) : (
                          <div class={`${styles.card} ${coming ? styles.cardComing : ''}`}>
                            <div class={styles.cardTop}>
                              <div class={styles.cardIcon}>
                                <span>{tool.icon}</span>
                              </div>
                              <div class={styles.cardStatus}>
                                <span class={`${styles.statusLabel} ${DOT_CLASS[tool.type]}`}>
                                  {STATUS_LABELS[tool.type]}
                                </span>
                              </div>
                            </div>
                            <div class={styles.cardName}>{tool.name}</div>
                            <p class={styles.cardDesc}>{tool.desc}</p>
                            <div class={styles.cardFooter}>
                              <div class={styles.cardTags}>
                                {tool.tags.split(' ').slice(0, 3).map(tag => (
                                  <span class={styles.tag}>{tag}</span>
                                ))}
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
          <div id="az-grid" class={styles.cardGrid} style="display: none;"></div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script>
  function initCatalog() {
    let activeQuery = '';
    let activeCat = 'all';
    let activeStatus: 'all' | 'open' | 'saas' | 'coming' = 'all';
    let activeSort: 'default' | 'az' = 'default';

    const searchInput = (document.getElementById('tool-nav-search') || document.getElementById('search')) as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('#cat-filters button');
    const statusButtons = document.querySelectorAll<HTMLButtonElement>('#status-filters button');
    const sortButtons = document.querySelectorAll<HTMLButtonElement>('#sort-filters button button[data-sort]');
    const resultCountEl = document.getElementById('result-count');
    const contentArea = document.getElementById('content-area');
    const categoryGroupsContainer = document.getElementById('category-groups-container');
    const azGrid = document.getElementById('az-grid');
    const menuToggle = document.getElementById('menu-toggle-btn');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    // Sidebar Mobile Toggle
    if (menuToggle && sidebar && overlay) {
      menuToggle.onclick = () => {
        sidebar.classList.toggle('styles_sidebarOpen');
        sidebar.classList.toggle('open');
        overlay.classList.toggle('show');
      };
      overlay.onclick = () => {
        sidebar.classList.remove('styles_sidebarOpen', 'open');
        overlay.classList.remove('show');
      };
    }

    // Keyboard shortcut "/"
    window.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      const isEditable = !!target && (
        target.isContentEditable ||
        ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
      );

      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !isEditable) {
        event.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      }
    });

    // Tool Cards and Category structures
    const cardItems = Array.from(document.querySelectorAll<HTMLElement>('.tool-card-item'));
    const categoryGroups = Array.from(document.querySelectorAll<HTMLElement>('.category-group'));
    const categoryGrids = new Map<string, HTMLElement>();
    const defaultCategoryCards = new Map<string, HTMLElement[]>();

    categoryGroups.forEach(group => {
      const cat = group.dataset.groupCat || '';
      const grid = group.querySelector<HTMLElement>('.card-grid-container');
      if (cat && grid) {
        categoryGrids.set(cat, grid);
        defaultCategoryCards.set(cat, Array.from(grid.querySelectorAll<HTMLElement>('.tool-card-item')));
      }
    });

    function applyFilters() {
      const q = activeQuery.toLowerCase().trim();
      const visibleCards: HTMLElement[] = [];
      const visibleNames = new Set<string>();

      cardItems.forEach(card => {
        const name = (card.dataset.name || '').toLowerCase();
        const desc = (card.dataset.desc || '').toLowerCase();
        const tags = (card.dataset.tags || '').toLowerCase();
        const cat = card.dataset.cat || '';
        const type = card.dataset.type || '';

        const matchesCat = activeCat === 'all' || cat === activeCat;
        const matchesStatus = activeStatus === 'all' || type === activeStatus;
        const matchesQuery = !q || name.includes(q) || desc.includes(q) || tags.includes(q) || cat.toLowerCase().includes(q);

        if (matchesCat && matchesStatus && matchesQuery) {
          visibleCards.push(card);
          visibleNames.add(card.dataset.name || '');
        }
      });

      const visibleCount = visibleCards.length;

      if (activeSort === 'az' && activeCat === 'all') {
        if (categoryGroupsContainer) categoryGroupsContainer.style.display = 'none';
        if (azGrid) {
          azGrid.style.display = visibleCount > 0 ? '' : 'none';
          const azSorted = [...visibleCards].sort((a, b) =>
            (a.dataset.name || '').localeCompare(b.dataset.name || '')
          );
          azSorted.forEach(card => {
            card.style.display = '';
            azGrid.appendChild(card);
          });
        }
      } else {
        if (azGrid) azGrid.style.display = 'none';
        if (categoryGroupsContainer) categoryGroupsContainer.style.display = '';

        categoryGroups.forEach(group => {
          const cat = group.dataset.groupCat || '';
          const grid = categoryGrids.get(cat);
          const originalCards = defaultCategoryCards.get(cat) || [];

          if (activeCat !== 'all' && activeCat !== cat) {
            group.style.display = 'none';
          } else {
            let cardsToAppend = originalCards;
            if (activeSort === 'az') {
              cardsToAppend = [...originalCards].sort((a, b) =>
                (a.dataset.name || '').localeCompare(b.dataset.name || '')
              );
            }
            let hasVisible = false;
            cardsToAppend.forEach(card => {
              grid?.appendChild(card);
              const isVisible = visibleNames.has(card.dataset.name || '');
              card.style.display = isVisible ? '' : 'none';
              if (isVisible) hasVisible = true;
            });
            group.style.display = hasVisible ? '' : 'none';
          }
        });
      }

      if (resultCountEl) {
        resultCountEl.innerHTML = `<strong>${visibleCount}</strong> tool${visibleCount !== 1 ? 's' : ''}`;
      }

      // Empty state
      let emptyEl = document.getElementById('catalog-empty-state');
      if (visibleCount === 0) {
        if (!emptyEl && contentArea) {
          emptyEl = document.createElement('div');
          emptyEl.id = 'catalog-empty-state';
          emptyEl.style.padding = '4rem 1rem';
          emptyEl.style.textAlign = 'center';
          emptyEl.style.color = 'var(--text-muted)';
          emptyEl.innerHTML = `
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔍</div>
            <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem;">No tools found</h3>
            <p>Try a different search or filter.</p>
          `;
          contentArea.appendChild(emptyEl);
        }
      } else if (emptyEl) {
        emptyEl.remove();
      }
    }

    // Search event
    searchInput?.addEventListener('input', (e) => {
      activeQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchInput.value = '';
        activeQuery = '';
        applyFilters();
      }
    });

    // Category button events
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        activeCat = btn.dataset.cat || 'all';
        applyFilters();
      });
    });

    // Status button events
    statusButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        statusButtons.forEach(b => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        activeStatus = (btn.dataset.status || 'all') as any;
        applyFilters();
      });
    });

    // Sort button events
    sortButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        sortButtons.forEach(b => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        activeSort = (btn.dataset.sort || 'default') as any;
        applyFilters();
      });
    });
  }

  initCatalog();
</script>
