{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*", "./*"]
    },
    "types": ["astro/client", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "lib/**/*",
    "functions/**/*",
    "__tests__/**/*"
  ],
  "exclude": [
    ".astro/**",
    "dist",
    "node_modules",
    "out",
    "public",
    "src/**/__tests__",
    "coverage",
    "playwright-report",
    "test-results",
  ]
}
