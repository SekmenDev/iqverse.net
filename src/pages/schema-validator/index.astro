---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const SAMPLE_TEMPLATES: Record<string, string> = {
  Article: `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Understanding AI Agents and Web Standards",
  "image": ["https://example.com/photos/1x1/photo.jpg"],
  "datePublished": "2026-01-15T08:00:00+08:00",
  "dateModified": "2026-02-01T09:20:00+08:00",
  "author": [{
    "@type": "Person",
    "name": "Jane Doe",
    "url": "https://example.com/profile/janedoe"
  }]
}`,
  Product: `{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "Developer Pro Laptop",
  "image": ["https://example.com/photos/laptop.jpg"],
  "description": "High performance laptop built for AI development.",
  "sku": "0446310",
  "brand": {
    "@type": "Brand",
    "name": "TechCorp"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://example.com/laptop",
    "priceCurrency": "USD",
    "price": "1499.00",
    "availability": "https://schema.org/InStock"
  }
}`,
  Organization: `{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "IQVerse",
  "url": "https://iqverse.net",
  "logo": "https://iqverse.net/logo.png",
  "sameAs": [
    "https://github.com/SekmenDev/iqverse.net"
  ]
}`,
  FAQ: `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "Is IQVerse free?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, IQVerse provides open-source tools running client-side in the browser."
    }
  }]
}`,
};
---

<ToolLayout
  title="Structured Data (Schema.org) Validator"
  subtitle="JSON-LD & Schema.org Rich Snippets Linter"
  pill="AI & AGENTS"
  toolSlug="schema-validator"
  description="Validate JSON-LD structured data and Schema.org markup online. Ensure rich snippet compatibility for search engines and AI web crawlers."
>
  <div style="max-width: 1050px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
          <label class={sharedStyles.fieldLabel} for="schemaInput">
            JSON-LD Schema Markup (or HTML &lt;script&gt;)
          </label>
          <div style="display: flex; gap: 6px; align-items: center;">
            <span style="font-size: 0.8rem; color: var(--text-muted);">Load Template:</span>
            {Object.keys(SAMPLE_TEMPLATES).map((key) => (
              <button
                type="button"
                class="tpl-btn"
                data-key={key}
                style="padding: 2px 8px; border-radius: 4px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font-size: 0.75rem; cursor: pointer;"
              >
                {key}
              </button>
            ))}
          </div>
        </div>

        <textarea
          id="schemaInput"
          class={sharedStyles.textarea}
          rows="12"
          style="font-family: monospace; font-size: 0.85rem;"
        >{SAMPLE_TEMPLATES.Article}</textarea>

        <div style="margin-top: 16px; display: flex; gap: 10px;">
          <button
            type="button"
            id="btn-validate-schema"
            class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
          >
            Validate Structured Data
          </button>
          <button
            type="button"
            id="btn-format-schema"
            class={`${sharedStyles.button} ${sharedStyles.buttonSecondary}`}
          >
            Format JSON
          </button>
        </div>

        <div id="schema-results-box" style="margin-top: 24px; display: none;"></div>
      </div>
    </section>
  </div>
</ToolLayout>

<script is:inline define:vars={{ SAMPLE_TEMPLATES }}>
  const schemaInput = document.getElementById('schemaInput');
  const btnValidate = document.getElementById('btn-validate-schema');
  const btnFormat = document.getElementById('btn-format-schema');
  const resultsBox = document.getElementById('schema-results-box');
  const tplBtns = document.querySelectorAll('.tpl-btn');

  tplBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.key;
      if (key && SAMPLE_TEMPLATES[key] && schemaInput) {
        schemaInput.value = SAMPLE_TEMPLATES[key];
        validate();
      }
    });
  });

  btnFormat?.addEventListener('click', () => {
    if (!schemaInput) return;
    try {
      let val = schemaInput.value.trim();
      if (val.includes('<script')) {
        const match = val.match(/<script[^>]*>([\s\S]*?)<\/script>/i);
        if (match) val = match[1].trim();
      }
      const parsed = JSON.parse(val);
      schemaInput.value = JSON.stringify(parsed, null, 2);
    } catch {
      // ignore invalid json during formatting
    }
  });

  function validate() {
    if (!schemaInput || !resultsBox) return;
    const raw = schemaInput.value.trim();
    if (!raw) {
      resultsBox.style.display = 'none';
      return;
    }

    let clean = raw;
    if (clean.includes('<script')) {
      const match = clean.match(/<script[^>]*>([\s\S]*?)<\/script>/i);
      if (match) clean = match[1].trim();
    }

    const errors = [];
    const warnings = [];
    let parsed = null;
    let typeFound = null;
    let contextFound = null;
    let properties = [];

    try {
      parsed = JSON.parse(clean);
    } catch (err) {
      errors.push(`JSON Syntax Error: ${err.message}`);
    }

    if (parsed) {
      if (typeof parsed !== 'object' || parsed === null) {
        errors.push('Schema root must be a valid JSON object.');
      } else {
        contextFound = parsed['@context'];
        typeFound = parsed['@type'];
        properties = Object.keys(parsed);

        if (!contextFound) {
          errors.push("Missing required '@context' property (expected 'https://schema.org').");
        } else if (!String(contextFound).includes('schema.org')) {
          warnings.push(`Unusual @context value: '${contextFound}'`);
        }

        if (!typeFound) {
          errors.push("Missing required '@type' property (e.g. 'Article', 'Product', 'Organization').");
        }
      }
    }

    resultsBox.style.display = 'block';
    const isSuccess = errors.length === 0;

    resultsBox.innerHTML = `
      <div style="padding: 16px; border-radius: 8px; background: ${isSuccess ? 'rgba(76, 175, 80, 0.1)' : 'rgba(255, 77, 79, 0.1)'}; border: 1px solid ${isSuccess ? '#4caf50' : '#ff4d4f'};">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <h4 style="margin: 0; color: ${isSuccess ? '#4caf50' : '#ff4d4f'};">
            ${isSuccess ? '✓ Valid Schema.org Structured Data' : '✕ Schema Validation Errors'}
          </h4>
          ${typeFound ? `<span style="padding: 2px 10px; border-radius: 12px; background: rgba(33, 150, 243, 0.2); color: #2196f3; font-weight: bold; font-size: 0.8rem;">@type: ${typeFound}</span>` : ''}
        </div>

        ${errors.length > 0 ? `<div style="color: #ff4d4f; font-size: 0.9rem; margin-bottom: 6px;"><strong>Errors:</strong> ${errors.join(' | ')}</div>` : ''}
        ${warnings.length > 0 ? `<div style="color: #faad14; font-size: 0.9rem; margin-bottom: 6px;"><strong>Warnings:</strong> ${warnings.join(' | ')}</div>` : ''}

        ${
          isSuccess
            ? `
          <div style="margin-top: 12px; font-size: 0.85rem; color: var(--text-muted);">
            Detected Properties: <strong>${properties.join(', ')}</strong>
          </div>
        `
            : ''
        }
      </div>
    `;
  }

  btnValidate?.addEventListener('click', validate);
  validate();
</script>
