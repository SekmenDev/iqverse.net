---
import ToolLayout from '@/layouts/ToolLayout.astro';
import styles from '@/styles/robots-generator.module.css';
---

<ToolLayout
  title="robots.txt Generator & Tester"
  subtitle="Build & Validate Crawler Directives for Search Engines & AI Bots"
  pill="BROWSER TOOLS"
  toolSlug="robots-generator"
  description="Generate and test robots.txt directives for Googlebot, Bingbot, GPTBot and web crawlers with live path testing."
>
  <div class={styles.container}>
    <div class={styles.card}>
      <!-- Presets -->
      <div class={styles.presetsBar}>
        <span class={styles.presetsLabel}>Templates:</span>
        <button type="button" class={styles.presetBtn} id="preset-standard">
          Standard SEO
        </button>
        <button type="button" class={styles.presetBtn} id="preset-block-ai">
          Block AI Scrapers (GPTBot, Claude, CCBot)
        </button>
        <button type="button" class={styles.presetBtn} id="preset-allow-all">
          Allow All Crawlers
        </button>
        <button type="button" class={styles.presetBtn} id="preset-block-all">
          Disallow All (Staging / Private)
        </button>
      </div>

      <!-- Sitemap -->
      <div class={styles.field}>
        <label class={styles.fieldLabel} for="sitemapInput">
          <span>Sitemap URL Reference</span>
          <span style="font-size: 0.75rem; text-transform: none; opacity: 0.7;">Included at the bottom of robots.txt</span>
        </label>
        <input
          id="sitemapInput"
          type="text"
          value="https://iqverse.net/sitemap.xml"
          class={styles.textInput}
          placeholder="https://example.com/sitemap.xml"
        />
      </div>

      <!-- Directive Groups -->
      <div style="margin-top: 24px; margin-bottom: 24px;">
        <div class={styles.sectionHeader}>
          <div>
            <h3 class={styles.sectionTitle}>User-Agent Directive Groups</h3>
            <p style="margin: 4px 0 0; font-size: 0.84rem; color: var(--text-muted);">
              Configure Allow and Disallow path patterns for specific crawlers or all bots (<code style="color: var(--accent);">*</code>).
            </p>
          </div>
          <button type="button" id="btn-add-robots-group" class={styles.btnAddGroup}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add User-Agent Group
          </button>
        </div>

        <div id="robots-groups-container"></div>
      </div>

      <!-- Interactive Path Tester -->
      <div class={styles.testerBox}>
        <h4 class={styles.testerHeader}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          Live Path Access Tester
        </h4>
        <p style="margin: 0 0 12px; font-size: 0.84rem; color: var(--text-muted);">
          Simulate whether a specific bot can crawl a target URL path based on your current directives above.
        </p>

        <div class={styles.testerRow}>
          <input
            id="testAgent"
            type="text"
            class={styles.textInput}
            placeholder="User-Agent (e.g. Googlebot, GPTBot, *)"
            value="*"
            style="flex: 1; min-width: 160px;"
          />
          <input
            id="testPath"
            type="text"
            class={styles.textInput}
            placeholder="Path to test (e.g. /admin/dashboard, /public/docs)"
            value="/admin/dashboard"
            style="flex: 2; min-width: 200px;"
          />
          <button type="button" id="btn-test-directive" class={styles.btnSecondary} style="min-height: 40px; padding: 0 20px;">
            Test Path Access
          </button>
        </div>
        <div id="test-directive-result" class={styles.testerResult}></div>
      </div>

      <!-- Output -->
      <div class={styles.field}>
        <div class={styles.outputHeader}>
          <label class={styles.fieldLabel} for="robotsOutput">
            <span>Generated robots.txt Output</span>
          </label>
          <div class={styles.outputActions}>
            <button type="button" id="btn-copy-robots-txt" class={styles.btnSecondary}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-btn-text">Copy robots.txt</span>
            </button>
            <button type="button" id="btn-download-robots-txt" class={styles.btnPrimary}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download File
            </button>
          </div>
        </div>
        <textarea
          id="robotsOutput"
          readonly
          class={styles.outputTextarea}
          rows="10"
        ></textarea>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  import styles from '@/styles/robots-generator.module.css';
  import {
    type RobotsRuleGroup,
    generateRobotsTxt,
    testRobotsPathAccess,
    STANDARD_ROBOTS_PRESET,
    BLOCK_AI_ROBOTS_PRESET,
    ALLOW_ALL_ROBOTS_PRESET,
    BLOCK_ALL_ROBOTS_PRESET,
  } from '@/lib/robots';

  let groups: RobotsRuleGroup[] = [
    {
      userAgent: '*',
      disallows: ['/admin/', '/private/'],
      allows: ['/public/'],
    },
    {
      userAgent: 'GPTBot',
      disallows: ['/private-data/'],
      allows: ['/'],
    },
  ];

  const sitemapInput = document.getElementById('sitemapInput') as HTMLInputElement;
  const btnAddGroup = document.getElementById('btn-add-robots-group');
  const groupsContainer = document.getElementById('robots-groups-container');
  const robotsOutput = document.getElementById('robotsOutput') as HTMLTextAreaElement;
  const btnCopy = document.getElementById('btn-copy-robots-txt');
  const copyBtnText = document.getElementById('copy-btn-text');
  const btnDownload = document.getElementById('btn-download-robots-txt');

  const testAgentInput = document.getElementById('testAgent') as HTMLInputElement;
  const testPathInput = document.getElementById('testPath') as HTMLInputElement;
  const btnTest = document.getElementById('btn-test-directive');
  const testResult = document.getElementById('test-directive-result');

  // Preset buttons
  document.getElementById('preset-standard')?.addEventListener('click', () => {
    groups = JSON.parse(JSON.stringify(STANDARD_ROBOTS_PRESET));
    renderGroups();
    updateRobots();
  });

  document.getElementById('preset-block-ai')?.addEventListener('click', () => {
    groups = JSON.parse(JSON.stringify(BLOCK_AI_ROBOTS_PRESET));
    renderGroups();
    updateRobots();
  });

  document.getElementById('preset-allow-all')?.addEventListener('click', () => {
    groups = JSON.parse(JSON.stringify(ALLOW_ALL_ROBOTS_PRESET));
    renderGroups();
    updateRobots();
  });

  document.getElementById('preset-block-all')?.addEventListener('click', () => {
    groups = JSON.parse(JSON.stringify(BLOCK_ALL_ROBOTS_PRESET));
    renderGroups();
    updateRobots();
  });

  function renderGroups() {
    if (!groupsContainer) return;
    groupsContainer.innerHTML = groups
      .map(
        (group, gIdx) => `
      <div class="${styles.groupCard}">
        <div class="${styles.groupHeader}">
          <span class="${styles.uaLabel}">User-agent:</span>
          <input
            type="text"
            class="${styles.uaInput} ua-input"
            data-gidx="${gIdx}"
            value="${group.userAgent}"
            placeholder="* or Googlebot, GPTBot, Bingbot"
          />
          <button
            type="button"
            class="${styles.btnRemoveGroup} btn-remove-group"
            data-gidx="${gIdx}"
            title="Delete this directive group"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            Delete Group
          </button>
        </div>

        <div class="${styles.rulesGrid}">
          <div>
            <div class="${styles.ruleColumnHeader}">
              <span style="color: var(--red);">●</span> Disallow Paths
            </div>
            <div class="${styles.ruleList}">
              ${(group.disallows || [])
                .map(
                  (d, dIdx) => `
                <div class="${styles.ruleRow}">
                  <input
                    type="text"
                    class="${styles.ruleInput} disallow-input"
                    data-gidx="${gIdx}"
                    data-didx="${dIdx}"
                    value="${d}"
                    placeholder="/path/to/block/"
                  />
                  <button type="button" class="${styles.btnRemoveRule} btn-remove-disallow" data-gidx="${gIdx}" data-didx="${dIdx}">✕</button>
                </div>
              `
                )
                .join('')}
              <button type="button" class="${styles.btnAddRule} btn-add-disallow" data-gidx="${gIdx}">
                + Add Disallow Rule
              </button>
            </div>
          </div>

          <div>
            <div class="${styles.ruleColumnHeader}">
              <span style="color: var(--green);">●</span> Allow Paths
            </div>
            <div class="${styles.ruleList}">
              ${(group.allows || [])
                .map(
                  (a, aIdx) => `
                <div class="${styles.ruleRow}">
                  <input
                    type="text"
                    class="${styles.ruleInput} allow-input"
                    data-gidx="${gIdx}"
                    data-aidx="${aIdx}"
                    value="${a}"
                    placeholder="/path/to/allow/"
                  />
                  <button type="button" class="${styles.btnRemoveRule} btn-remove-allow" data-gidx="${gIdx}" data-aidx="${aIdx}">✕</button>
                </div>
              `
                )
                .join('')}
              <button type="button" class="${styles.btnAddRule} btn-add-allow" data-gidx="${gIdx}">
                + Add Allow Rule
              </button>
            </div>
          </div>
        </div>
      </div>
    `
      )
      .join('');

    // Reattach listeners
    document.querySelectorAll('.ua-input').forEach((el) => {
      el.addEventListener('input', (e) => {
        const gIdx = Number((e.target as HTMLElement).dataset.gidx);
        if (groups[gIdx]) {
          groups[gIdx].userAgent = (e.target as HTMLInputElement).value;
          updateRobots();
        }
      });
    });

    document.querySelectorAll('.btn-remove-group').forEach((el) => {
      el.addEventListener('click', (e) => {
        const gIdx = Number((e.currentTarget as HTMLElement).dataset.gidx);
        groups = groups.filter((_, idx) => idx !== gIdx);
        renderGroups();
        updateRobots();
      });
    });

    document.querySelectorAll('.disallow-input').forEach((el) => {
      el.addEventListener('input', (e) => {
        const gIdx = Number((e.target as HTMLElement).dataset.gidx);
        const dIdx = Number((e.target as HTMLElement).dataset.didx);
        if (groups[gIdx]?.disallows) {
          groups[gIdx].disallows[dIdx] = (e.target as HTMLInputElement).value;
          updateRobots();
        }
      });
    });

    document.querySelectorAll('.btn-remove-disallow').forEach((el) => {
      el.addEventListener('click', (e) => {
        const gIdx = Number((e.currentTarget as HTMLElement).dataset.gidx);
        const dIdx = Number((e.currentTarget as HTMLElement).dataset.didx);
        if (groups[gIdx]?.disallows) {
          groups[gIdx].disallows = groups[gIdx].disallows.filter((_, i) => i !== dIdx);
          renderGroups();
          updateRobots();
        }
      });
    });

    document.querySelectorAll('.btn-add-disallow').forEach((el) => {
      el.addEventListener('click', (e) => {
        const gIdx = Number((e.currentTarget as HTMLElement).dataset.gidx);
        if (groups[gIdx]) {
          groups[gIdx].disallows = groups[gIdx].disallows || [];
          groups[gIdx].disallows.push('/admin/');
          renderGroups();
          updateRobots();
        }
      });
    });

    document.querySelectorAll('.allow-input').forEach((el) => {
      el.addEventListener('input', (e) => {
        const gIdx = Number((e.target as HTMLElement).dataset.gidx);
        const aIdx = Number((e.target as HTMLElement).dataset.aidx);
        if (groups[gIdx]?.allows) {
          groups[gIdx].allows[aIdx] = (e.target as HTMLInputElement).value;
          updateRobots();
        }
      });
    });

    document.querySelectorAll('.btn-remove-allow').forEach((el) => {
      el.addEventListener('click', (e) => {
        const gIdx = Number((e.currentTarget as HTMLElement).dataset.gidx);
        const aIdx = Number((e.currentTarget as HTMLElement).dataset.aidx);
        if (groups[gIdx]?.allows) {
          groups[gIdx].allows = groups[gIdx].allows.filter((_, i) => i !== aIdx);
          renderGroups();
          updateRobots();
        }
      });
    });

    document.querySelectorAll('.btn-add-allow').forEach((el) => {
      el.addEventListener('click', (e) => {
        const gIdx = Number((e.currentTarget as HTMLElement).dataset.gidx);
        if (groups[gIdx]) {
          groups[gIdx].allows = groups[gIdx].allows || [];
          groups[gIdx].allows.push('/');
          renderGroups();
          updateRobots();
        }
      });
    });
  }

  function updateRobots() {
    const sitemap = sitemapInput?.value.trim() || '';
    if (robotsOutput) robotsOutput.value = generateRobotsTxt(groups, sitemap);
  }

  btnAddGroup?.addEventListener('click', () => {
    groups.push({
      userAgent: 'NewBot',
      disallows: ['/'],
      allows: [],
    });
    renderGroups();
    updateRobots();
  });

  sitemapInput?.addEventListener('input', updateRobots);

  btnCopy?.addEventListener('click', async () => {
    if (robotsOutput?.value) {
      await navigator.clipboard.writeText(robotsOutput.value);
      if (copyBtnText) copyBtnText.textContent = 'Copied!';
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = 'Copy robots.txt';
      }, 1500);
    }
  });

  btnDownload?.addEventListener('click', () => {
    if (!robotsOutput?.value) return;
    const blob = new Blob([robotsOutput.value], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'robots.txt';
    a.click();
    URL.revokeObjectURL(url);
  });

  btnTest?.addEventListener('click', () => {
    if (!testResult) return;
    const testAgent = testAgentInput?.value.trim() || '*';
    const testPath = testPathInput?.value.trim() || '/';

    const test = testRobotsPathAccess(groups, testAgent, testPath);

    testResult.style.display = 'block';
    if (test.allowed) {
      testResult.style.borderColor = 'var(--green)';
      testResult.style.background = 'rgba(74, 222, 128, 0.1)';
      testResult.innerHTML = `<strong>✓ Allowed</strong>: ${test.reason}`;
    } else {
      testResult.style.borderColor = 'var(--red)';
      testResult.style.background = 'rgba(248, 113, 113, 0.1)';
      testResult.innerHTML = `<strong>✕ Blocked</strong>: ${test.reason}`;
    }
  });

  renderGroups();
  updateRobots();
</script>
