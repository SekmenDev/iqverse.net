---
import ToolLayout from '@/layouts/ToolLayout.astro';
import CapCaptcha from '@/components/CapCaptcha.astro';
import styles from '@/styles/header-scan.module.css';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const SAMPLE_URLS = ['https://example.com', 'https://github.com', 'https://google.com'];
---

<ToolLayout
  title="HeaderScan"
  subtitle="HTTP Security & Performance Header Analyzer"
  pill="SECURITY"
  toolSlug="headers"
  description="Analyze HTTP response headers for any web URL. Inspect security policies, cache directives, server configurations, and CSP."
>
  <div style="max-width: 1100px;">
    <section class={styles.heroSection}>
      <form id="header-scan-form" class={styles.form}>
        <div class={styles.inputGroup}>
          <input
            id="url-input"
            type="url"
            class={styles.urlInput}
            placeholder="https://example.com"
            value="https://example.com"
            required
          />
          <button type="submit" id="scan-submit-btn" class={styles.scanButton}>
            Scan Headers
          </button>
        </div>
        <div style="margin-top: 12px;">
          <CapCaptcha />
        </div>
      </form>

      <div class={styles.samples}>
        <span>Try:</span>
        {SAMPLE_URLS.map((u) => (
          <button type="button" class="sample-btn" data-url={u}>
            {u}
          </button>
        ))}
      </div>
    </section>

    <div id="scan-loading" class={styles.loadingBox} style="display: none;">
      <div class={styles.spinner}></div>
      <p>Analyzing HTTP response headers...</p>
    </div>

    <div id="scan-error" class={sharedStyles.errorCard} style="margin-top: 20px; display: none;">
      <div id="scan-error-msg" class={sharedStyles.errorMessage}></div>
    </div>

    <section id="scan-results-section" style="display: none; margin-top: 24px;">
      <!-- Score Overview -->
      <div class={styles.scoreCard}>
        <div class={styles.scoreRow}>
          <div>
            <span class={styles.scoreMeta}>Target URL</span>
            <h3 id="target-url-display" class={styles.targetUrl}></h3>
          </div>
          <div class={styles.scoreBadgeWrap}>
            <span class={styles.scoreMeta}>Security Score</span>
            <div id="score-badge" class={styles.scoreBadge}>--</div>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class={styles.tabs}>
        <button type="button" class="header-tab-btn" data-tab="security" style="padding: 8px 16px; border-radius: 6px; border: 1px solid var(--accent); background: var(--surface); color: var(--text); cursor: pointer;">
          Security (<span id="count-security">0</span>)
        </button>
        <button type="button" class="header-tab-btn" data-tab="performance" style="padding: 8px 16px; border-radius: 6px; border: 1px solid transparent; background: var(--surface); color: var(--text); cursor: pointer;">
          Performance (<span id="count-performance">0</span>)
        </button>
        <button type="button" class="header-tab-btn" data-tab="info" style="padding: 8px 16px; border-radius: 6px; border: 1px solid transparent; background: var(--surface); color: var(--text); cursor: pointer;">
          Info (<span id="count-info">0</span>)
        </button>
        <button type="button" class="header-tab-btn" data-tab="raw" style="padding: 8px 16px; border-radius: 6px; border: 1px solid transparent; background: var(--surface); color: var(--text); cursor: pointer;">
          Raw Headers (<span id="count-raw">0</span>)
        </button>
      </div>

      <!-- Tab Contents -->
      <div id="tab-content-security" class="tab-pane" style="margin-top: 16px;"></div>
      <div id="tab-content-performance" class="tab-pane" style="margin-top: 16px; display: none;"></div>
      <div id="tab-content-info" class="tab-pane" style="margin-top: 16px; display: none;"></div>
      <div id="tab-content-raw" class="tab-pane" style="margin-top: 16px; display: none;">
        <div class={sharedStyles.card}>
          <pre id="raw-headers-output" style="max-height: 400px; overflow: auto; font-family: monospace;"></pre>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { analyzeHeaders, type HeaderAssessment } from '@/lib/headers';
  import { validateCaptcha } from '@/lib/captcha';

  const form = document.getElementById('header-scan-form') as HTMLFormElement;
  const urlInput = document.getElementById('url-input') as HTMLInputElement;
  const sampleBtns = document.querySelectorAll('.sample-btn');

  const loadingBox = document.getElementById('scan-loading');
  const errorBox = document.getElementById('scan-error');
  const errorMsg = document.getElementById('scan-error-msg');
  const resultsSection = document.getElementById('scan-results-section');
  const targetUrlEl = document.getElementById('target-url-display');
  const scoreBadge = document.getElementById('score-badge');
  const rawHeadersOut = document.getElementById('raw-headers-output');
  const tabBtns = document.querySelectorAll('.header-tab-btn');

  let activeTab = 'security';

  sampleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (urlInput) {
        urlInput.value = (btn as HTMLElement).dataset.url || '';
        const { valid } = validateCaptcha(form);
        if (valid) {
          form?.dispatchEvent(new Event('submit'));
        }
      }
    });
  });

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach((b) => ((b as HTMLElement).style.borderColor = 'transparent'));
      (btn as HTMLElement).style.borderColor = 'var(--accent)';
      activeTab = (btn as HTMLElement).dataset.tab || 'security';

      document.querySelectorAll('.tab-pane').forEach((pane) => {
        (pane as HTMLElement).style.display = 'none';
      });
      const currentPane = document.getElementById(`tab-content-${activeTab}`);
      if (currentPane) currentPane.style.display = 'block';
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = urlInput?.value.trim();
    if (!url) return;

    const { valid, token } = validateCaptcha(form);
    if (!valid) return;

    if (loadingBox) loadingBox.style.display = 'block';
    if (errorBox) errorBox.style.display = 'none';
    if (resultsSection) resultsSection.style.display = 'none';

    try {
      const result = await analyzeHeaders(url, token || undefined);

      if (targetUrlEl) targetUrlEl.textContent = result.url;
      if (scoreBadge) {
        scoreBadge.textContent = `${result.score}/100 Grade ${result.grade}`;
        scoreBadge.style.color = result.score >= 80 ? '#4caf50' : result.score >= 50 ? '#faad14' : '#ff4d4f';
      }

      // Counts
      const secItems = result.assessments.filter((a: HeaderAssessment) => a.category === 'security');
      const perfItems = result.assessments.filter((a: HeaderAssessment) => a.category === 'performance');
      const infoItems = result.assessments.filter((a: HeaderAssessment) => a.category === 'info');

      const countSec = document.getElementById('count-security');
      const countPerf = document.getElementById('count-performance');
      const countInfo = document.getElementById('count-info');
      const countRaw = document.getElementById('count-raw');

      if (countSec) countSec.textContent = String(secItems.length);
      if (countPerf) countPerf.textContent = String(perfItems.length);
      if (countInfo) countInfo.textContent = String(infoItems.length);
      if (countRaw) countRaw.textContent = String(Object.keys(result.rawHeaders).length);

      // Render cards helper
      const renderCards = (items: HeaderAssessment[]) => {
        return items
          .map((item: HeaderAssessment) => {
            const statusColor =
              item.status === 'pass'
                ? '#4caf50'
                : item.status === 'warn'
                ? '#faad14'
                : item.status === 'fail'
                ? '#ff4d4f'
                : '#2196f3';
            return `
            <div style="background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin-bottom: 12px; border-left: 4px solid ${statusColor};">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <strong>${item.name}</strong>
                <span style="text-transform: uppercase; font-size: 0.75rem; font-weight: bold; color: ${statusColor};">${item.status}</span>
              </div>
              <div style="font-size: 0.85rem; margin-bottom: 4px;">${item.message}</div>
              <div style="font-size: 0.8rem; color: var(--text-muted);">${item.description}</div>
              ${item.recommendation ? `<div style="font-size: 0.8rem; color: #faad14; margin-top: 6px;">💡 ${item.recommendation}</div>` : ''}
            </div>
          `;
          })
          .join('');
      };

      const paneSec = document.getElementById('tab-content-security');
      const panePerf = document.getElementById('tab-content-performance');
      const paneInfo = document.getElementById('tab-content-info');

      if (paneSec) paneSec.innerHTML = renderCards(secItems);
      if (panePerf) panePerf.innerHTML = renderCards(perfItems);
      if (paneInfo) paneInfo.innerHTML = renderCards(infoItems);

      if (rawHeadersOut) {
        rawHeadersOut.textContent = Object.entries(result.rawHeaders)
          .map(([k, v]) => `${k}: ${v}`)
          .join('\n');
      }

      if (resultsSection) resultsSection.style.display = 'block';
    } catch (err: any) {
      if (errorBox && errorMsg) {
        errorBox.style.display = 'block';
        errorMsg.textContent = err.message || 'Failed to scan headers.';
      }
    } finally {
      if (loadingBox) loadingBox.style.display = 'none';
    }
  });
</script>
