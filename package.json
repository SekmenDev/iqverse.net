{
  "name": "iqverse",
  "version": "2.5.0",
  "description": "IQVerse - Free open-source developer tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "lint": "eslint .",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "yarn build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "yarn build && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "vitest run && yarn test:e2e"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "astro": "7.3.1",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.1",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
