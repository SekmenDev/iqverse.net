{
  "name": "iqverse",
  "version": "2.5.0",
  "description": "IQVerse - Free open-source developer tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "lint": "eslint .",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "yarn build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "yarn build && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "vitest run && yarn test:e2e"
  },
  "dependencies": {
    "astro": "^7.2.7",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.1",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "jsdom": "^26.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.18.0"
}
