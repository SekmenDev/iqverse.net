---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const SAMPLE_SVG = `<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by Vector Graphic Software v1.2 -->
<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 100 100" enable-background="new 0 0 100 100" xml:space="preserve">
  <metadata>
    <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Work rdf:about="">
        <dc:format>image/svg+xml</dc:format>
      </rdf:Work>
    </rdf:RDF>
  </metadata>
  <g id="Layer_1">
    <circle cx="50.000" cy="50.000" r="40.000" fill="#2196F3" stroke="#000000" stroke-width="2.000"/>
  </g>
</svg>`;
---

<ToolLayout
  title="SVG Optimizer & Minifier"
  subtitle="Strip Metadata, Clean Attributes & Compress SVG Vector Code"
  pill="DESIGN"
  toolSlug="svg-optimizer"
  description="Optimize and minify SVG markup. Strip metadata, clean attributes and compress vector graphic code for web performance."
>
  <div style="max-width: 1100px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div style="display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; font-size: 0.875rem;">
          <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
            <input id="cb-remove-comments" type="checkbox" checked />
            Remove Comments
          </label>
          <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
            <input id="cb-remove-metadata" type="checkbox" checked />
            Remove XML Metadata
          </label>
          <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
            <input id="cb-remove-doctype" type="checkbox" checked />
            Remove XML Header & Doctype
          </label>
          <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
            <input id="cb-minify-whitespace" type="checkbox" checked />
            Minify Whitespace
          </label>
        </div>

        <!-- Stats Bar -->
        <div
          style="padding: 12px; border-radius: 6px; background: rgba(76, 175, 80, 0.1); border: 1px solid rgba(76, 175, 80, 0.3); margin-bottom: 20px; display: flex; gap: 20px; align-items: center; font-size: 0.9rem; flex-wrap: wrap;"
        >
          <div>Original: <strong id="svg-stat-orig">0 bytes</strong></div>
          <div>Optimized: <strong id="svg-stat-opt">0 bytes</strong></div>
          <div style="color: #4caf50; font-weight: bold;">
            Saved: <span id="svg-stat-saved">0 bytes (0%)</span>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
          <div class={sharedStyles.field}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
              <label class={sharedStyles.fieldLabel} for="svgInput" style="margin-bottom: 0;">
                Raw SVG Code Input
              </label>
              <div style="display: flex; gap: 8px; align-items: center;">
                <input
                  type="file"
                  id="svgFileInput"
                  accept=".svg,image/svg+xml"
                  style="display: none;"
                />
                <button type="button" id="btn-upload-svg" class={sharedStyles.button}>
                  Upload File
                </button>
                <button type="button" id="btn-clear-svg" class={sharedStyles.button}>
                  Clear
                </button>
              </div>
            </div>
            <textarea
              id="svgInput"
              class={sharedStyles.textarea}
              rows="12"
              placeholder="Paste SVG code or drop an SVG file here..."
              style="font-family: monospace; font-size: 0.85rem;"
            >{SAMPLE_SVG}</textarea>
            <div id="file-name-display" style="margin-top: 6px; font-size: 0.8rem; color: var(--text-muted); display: none;">
              Loaded: <span id="file-name-text"></span>
            </div>
          </div>

          <div class={sharedStyles.field}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <label class={sharedStyles.fieldLabel} for="svgOptOutput">
                Optimized SVG Code
              </label>
              <div style="display: flex; gap: 8px;">
                <button type="button" id="btn-copy-svg" class={sharedStyles.button}>
                  Copy SVG
                </button>
                <button type="button" id="btn-download-svg" class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}>
                  Download
                </button>
              </div>
            </div>
            <textarea
              id="svgOptOutput"
              readonly
              class={sharedStyles.outputArea}
              rows="12"
              style="font-family: monospace; font-size: 0.85rem;"
            ></textarea>
          </div>
        </div>

        <!-- SVG Preview Card -->
        <div style="margin-top: 24px;">
          <h4 style="margin-bottom: 12px;">Visual SVG Preview</h4>
          <div
            id="svg-visual-preview"
            style="padding: 24px; border-radius: 8px; background: rgba(0, 0, 0, 0.3); border: 1px dashed var(--border); display: flex; align-items: center; justify-content: center; min-height: 120px;"
          ></div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { optimizeSvgCode, calculateSvgSavings } from '@/lib/svg';

  const svgInput = document.getElementById('svgInput') as HTMLTextAreaElement | null;
  const svgOptOutput = document.getElementById('svgOptOutput') as HTMLTextAreaElement | null;
  const fileInput = document.getElementById('svgFileInput') as HTMLInputElement | null;
  const btnUpload = document.getElementById('btn-upload-svg');
  const btnClear = document.getElementById('btn-clear-svg');
  const fileNameDisplay = document.getElementById('file-name-display');
  const fileNameText = document.getElementById('file-name-text');

  const cbComments = document.getElementById('cb-remove-comments') as HTMLInputElement | null;
  const cbMetadata = document.getElementById('cb-remove-metadata') as HTMLInputElement | null;
  const cbDoctype = document.getElementById('cb-remove-doctype') as HTMLInputElement | null;
  const cbWhitespace = document.getElementById('cb-minify-whitespace') as HTMLInputElement | null;

  const statOrig = document.getElementById('svg-stat-orig');
  const statOpt = document.getElementById('svg-stat-opt');
  const statSaved = document.getElementById('svg-stat-saved');
  const previewBox = document.getElementById('svg-visual-preview');
  const btnCopy = document.getElementById('btn-copy-svg');
  const btnDownload = document.getElementById('btn-download-svg');

  let downloadFileName = 'optimized.svg';

  function setLoadedFile(name: string) {
    downloadFileName = name.replace(/\.svg$/i, '.min.svg') || 'optimized.svg';
    if (fileNameDisplay && fileNameText) {
      fileNameText.textContent = name;
      fileNameDisplay.style.display = 'block';
    }
  }

  function clearLoadedFile() {
    downloadFileName = 'optimized.svg';
    if (fileNameDisplay && fileNameText) {
      fileNameText.textContent = '';
      fileNameDisplay.style.display = 'none';
    }
  }

  function update() {
    const raw = svgInput?.value || '';
    const opt = optimizeSvgCode(raw, {
      removeComments: cbComments?.checked || false,
      removeMetadata: cbMetadata?.checked || false,
      removeDoctype: cbDoctype?.checked || false,
      minifyWhitespace: cbWhitespace?.checked || false,
    });

    if (svgOptOutput) svgOptOutput.value = opt;
    if (previewBox) previewBox.innerHTML = opt;

    const { origSize, optSize, savedBytes, savedPercent } = calculateSvgSavings(raw, opt);

    if (statOrig) statOrig.textContent = `${origSize} bytes`;
    if (statOpt) statOpt.textContent = `${optSize} bytes`;
    if (statSaved) statSaved.textContent = `${savedBytes} bytes (${savedPercent}%)`;
  }

  async function handleFile(file: File) {
    if (!file.name.toLowerCase().endsWith('.svg') && file.type !== 'image/svg+xml') {
      alert('Please select a valid .svg file.');
      return;
    }
    const content = await file.text();
    if (svgInput) {
      svgInput.value = content;
      setLoadedFile(file.name);
      update();
    }
  }

  btnUpload?.addEventListener('click', () => {
    fileInput?.click();
  });

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (file) {
      await handleFile(file);
      fileInput.value = '';
    }
  });

  btnClear?.addEventListener('click', () => {
    if (svgInput) {
      svgInput.value = '';
      clearLoadedFile();
      update();
      svgInput.focus();
    }
  });

  const resetDragState = () => {
    if (svgInput) {
      svgInput.style.borderColor = '';
      svgInput.style.boxShadow = '';
    }
  };

  svgInput?.addEventListener('dragover', (event: DragEvent) => {
    event.preventDefault();
    if (svgInput) {
      svgInput.style.borderColor = 'var(--accent)';
      svgInput.style.boxShadow = '0 0 0 3px var(--accent-dim)';
    }
  });

  svgInput?.addEventListener('dragleave', resetDragState);
  svgInput?.addEventListener('dragend', resetDragState);

  svgInput?.addEventListener('drop', async (event: DragEvent) => {
    event.preventDefault();
    resetDragState();
    const file = event.dataTransfer?.files?.[0];
    if (file) {
      await handleFile(file);
      return;
    }
    const text = event.dataTransfer?.getData('text');
    if (text && svgInput) {
      svgInput.value = text;
      clearLoadedFile();
      update();
    }
  });

  svgInput?.addEventListener('input', () => {
    if (!svgInput?.value) {
      clearLoadedFile();
    }
    update();
  });

  [cbComments, cbMetadata, cbDoctype, cbWhitespace].forEach((el) => {
    el?.addEventListener('input', update);
  });

  btnCopy?.addEventListener('click', async () => {
    if (svgOptOutput?.value && btnCopy) {
      await navigator.clipboard.writeText(svgOptOutput.value);
      const prev = btnCopy.textContent;
      btnCopy.textContent = 'Copied!';
      setTimeout(() => (btnCopy.textContent = prev), 1500);
    }
  });

  btnDownload?.addEventListener('click', () => {
    if (!svgOptOutput?.value) return;
    const blob = new Blob([svgOptOutput.value], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = downloadFileName;
    a.click();
    URL.revokeObjectURL(url);
  });

  update();
</script>
