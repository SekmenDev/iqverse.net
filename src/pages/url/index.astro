---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';
---

<ToolLayout
  title="URL Tools"
  subtitle="Parse, Inspect, Encode & Build URLs"
  pill="BROWSER TOOLS"
  toolSlug="url"
  description="Parse, inspect, encode, decode, and build web URLs. Manage query string parameters visually right inside your browser."
>
  <div style="max-width: 1000px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.sectionLabel}>URL Tools</div>
      <div class={sharedStyles.card}>
        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlInput">
            URL Input
          </label>
          <textarea
            id="urlInput"
            class={sharedStyles.textarea}
            rows="4"
          >https://example.com/path?foo=1&bar=two#section</textarea>
        </div>

        <div class={sharedStyles.buttonGroup}>
          <button type="button" id="btn-parse-url" class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}>
            Parse URL
          </button>
          <button type="button" id="btn-build-url" class={`${sharedStyles.button} ${sharedStyles.buttonSecondary}`}>
            Build URL
          </button>
          <button type="button" id="btn-encode-url" class={`${sharedStyles.button} ${sharedStyles.buttonSecondary}`}>
            Encode URL
          </button>
          <button type="button" id="btn-decode-url" class={`${sharedStyles.button} ${sharedStyles.buttonSecondary}`}>
            Decode URL
          </button>
        </div>

        <div class={sharedStyles.sectionLabel} style="margin-top: 24px;">
          Parsed URL Parts
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlProtocol">Protocol</label>
          <input
            id="urlProtocol"
            type="text"
            value="https:"
            class={sharedStyles.textarea}
            style="min-height: auto;"
          />
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlHost">Hostname</label>
          <input
            id="urlHost"
            type="text"
            value="example.com"
            class={sharedStyles.textarea}
            style="min-height: auto;"
          />
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlPort">Port</label>
          <input
            id="urlPort"
            type="text"
            class={sharedStyles.textarea}
            style="min-height: auto;"
          />
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlPathname">Pathname</label>
          <input
            id="urlPathname"
            type="text"
            value="/path"
            class={sharedStyles.textarea}
            style="min-height: auto;"
          />
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlHash">Hash</label>
          <input
            id="urlHash"
            type="text"
            value="#section"
            class={sharedStyles.textarea}
            style="min-height: auto;"
          />
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlQueryParams">Query Parameters (one per line)</label>
          <textarea
            id="urlQueryParams"
            class={sharedStyles.textarea}
            rows="5"
            placeholder="key=value&#10;foo=bar"
          >foo=1&#10;bar=two</textarea>
        </div>

        <div style="margin-top: 18px;" class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="urlOutput">Output URL</label>
          <textarea id="urlOutput" readonly class={sharedStyles.outputArea} rows="4"></textarea>
        </div>

        <div id="url-error-box" class={sharedStyles.errorCard} style="margin-top: 12px; display: none;">
          <div id="url-error-msg" class={sharedStyles.errorMessage}></div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import {
    parseUrlComponents,
    buildUrlString,
    encodeUrlString,
    decodeUrlString,
  } from '@/lib/url';

  const urlInput = document.getElementById('urlInput') as HTMLTextAreaElement;
  const protocolInput = document.getElementById('urlProtocol') as HTMLInputElement;
  const hostInput = document.getElementById('urlHost') as HTMLInputElement;
  const portInput = document.getElementById('urlPort') as HTMLInputElement;
  const pathnameInput = document.getElementById('urlPathname') as HTMLInputElement;
  const hashInput = document.getElementById('urlHash') as HTMLInputElement;
  const queryParamsInput = document.getElementById('urlQueryParams') as HTMLTextAreaElement;
  const urlOutput = document.getElementById('urlOutput') as HTMLTextAreaElement;
  const errorBox = document.getElementById('url-error-box');
  const errorMsg = document.getElementById('url-error-msg');

  const btnParse = document.getElementById('btn-parse-url');
  const btnBuild = document.getElementById('btn-build-url');
  const btnEncode = document.getElementById('btn-encode-url');
  const btnDecode = document.getElementById('btn-decode-url');

  function showError(msg: string) {
    if (errorBox && errorMsg) {
      errorMsg.textContent = msg;
      errorBox.style.display = 'block';
    }
  }

  function hideError() {
    if (errorBox) errorBox.style.display = 'none';
  }

  function parseUrl() {
    hideError();
    try {
      const candidate = urlInput?.value.trim() || 'https://example.com';
      const parsed = parseUrlComponents(candidate);

      if (protocolInput) protocolInput.value = parsed.protocol;
      if (hostInput) hostInput.value = parsed.hostname;
      if (portInput) portInput.value = parsed.port;
      if (pathnameInput) pathnameInput.value = parsed.pathname;
      if (hashInput) hashInput.value = parsed.hash;
      if (queryParamsInput) queryParamsInput.value = parsed.queryParams;
      if (urlOutput) urlOutput.value = parsed.href;
    } catch (err: any) {
      showError(err.message || 'Invalid URL.');
      if (urlOutput) urlOutput.value = '';
    }
  }

  function buildUrl() {
    hideError();
    try {
      const built = buildUrlString({
        protocol: protocolInput?.value,
        host: hostInput?.value,
        port: portInput?.value,
        pathname: pathnameInput?.value,
        hash: hashInput?.value,
        queryParams: queryParamsInput?.value,
      });

      if (urlOutput) urlOutput.value = built;
      if (urlInput) urlInput.value = built;
    } catch (err: any) {
      showError(err.message || 'Unable to build URL.');
      if (urlOutput) urlOutput.value = '';
    }
  }

  btnParse?.addEventListener('click', parseUrl);
  btnBuild?.addEventListener('click', buildUrl);
  btnEncode?.addEventListener('click', () => {
    hideError();
    try {
      if (urlOutput && urlInput) urlOutput.value = encodeUrlString(urlInput.value.trim());
    } catch {
      showError('Unable to encode the URL.');
    }
  });
  btnDecode?.addEventListener('click', () => {
    hideError();
    try {
      if (urlOutput && urlInput) urlOutput.value = decodeUrlString(urlInput.value.trim());
    } catch {
      showError('Unable to decode the URL.');
    }
  });

  parseUrl();
</script>
