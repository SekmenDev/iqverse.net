---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import ToolNavSearch from "@/components/ToolNavSearch.astro";
import { getToolJsonLd } from "@/lib/jsonld";
import { primaryCategory, tools } from "@/lib/tools";
import styles from "@/styles/tool-layout.module.css";

export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  pill?: string;
  toolSlug?: string;
}

const {
  title,
  subtitle,
  description = "",
  pill = "TOOL",
  toolSlug,
} = Astro.props;

const initial = title.trim().charAt(0).toUpperCase() || "T";
const matchedTool =
  tools.find((t) => t.name.toLowerCase() === title.toLowerCase()) ||
  (toolSlug ? tools.find((t) => t.url.includes(toolSlug)) : undefined);
const slug =
  toolSlug ||
  matchedTool?.url.replaceAll("/", "") ||
  title.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-");
const jsonLdData = getToolJsonLd(
  title,
  description,
  `/${slug}/`,
  matchedTool && primaryCategory(matchedTool),
);
const canonicalUrl = `https://iqverse.net/${slug}/`;
const pageTitle = subtitle
  ? `${title} • ${subtitle} | IQVerse`
  : `${title} | IQVerse`;
---

<Layout
  title={pageTitle}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLdData}
>
  <main class={styles.page}>
    <nav class={styles.topNav}>
      <a class={styles.navLogo} href="/">
        <ThemeToggle />
        <span>IQVerse</span>
      </a>

      <div class={styles.navBreadcrumb}>
        <span>Tools</span>
        <span class={styles.sep}>/</span>
        <span class={styles.current}>{title}</span>
      </div>

      <ToolNavSearch />

      <div class={styles.navRight}>
        <a href="/gtr/" class={styles.navGtrCta}>
          GTR ↗
        </a>
        <a
          href="https://github.com/SekmenDev/iqverse.net"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          ><svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >GitHub
        </a>
      </div>
    </nav>

    <section class={styles.header}>
      <div class={styles.headerInner}>
        <div class={styles.headerIcon} aria-hidden="true">
          {initial}
        </div>

        <div class={styles.headerText}>
          <div class={styles.headerMeta}>
            {pill && <span class={styles.pill}>{pill}</span>}
            <span class={`${styles.badge} ${styles.badgeLive}`}
              >Open source</span
            >
          </div>

          <h1 class={styles.title}>
            {title}
            {subtitle && <span class={styles.titleEm}> {subtitle}</span>}
          </h1>

          {description && <p class={styles.description}>{description}</p>}

          <div class={styles.headerActions}>
            <a class={`${styles.btn} ${styles.btnGhost}`} href="/">
              Back home
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class={styles.content}>
      <slot />
    </section>
  </main>
</Layout>
