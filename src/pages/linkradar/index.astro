---
import ToolLayout from '@/layouts/ToolLayout.astro';
import CapCaptcha from '@/components/CapCaptcha.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';
---

<ToolLayout
  title="LinkRadar"
  subtitle="Broken Link Checker & Web Crawler"
  pill="BROWSER TOOLS"
  toolSlug="linkradar"
  description="Scan websites for broken links, dead URLs, HTTP redirect loops, and 404 response errors in real time."
>
  <div style="max-width: 1100px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <form id="linkradar-form">
          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="targetUrl">
              Website URL to Crawl & Scan
            </label>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <input
                id="targetUrl"
                type="url"
                value="https://iqverse.net"
                class={sharedStyles.input}
                style="flex: 1; min-width: 260px;"
                placeholder="https://example.com"
                required
              />
              <button
                type="submit"
                id="btn-start-scan"
                class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
              >
                Start Scan
              </button>
              <button
                type="button"
                id="btn-stop-scan"
                class={sharedStyles.button}
                style="display: none; color: #ff4d4f;"
              >
                Stop Scan
              </button>
            </div>
          </div>

          <div style="display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap; font-size: 0.85rem;">
            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
              <input id="opt-external" type="checkbox" checked />
              Check External Links
            </label>
            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
              <input id="opt-images" type="checkbox" checked />
              Check Image Sources (&lt;img&gt;)
            </label>
            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
              <input id="opt-crawl" type="checkbox" checked />
              Crawl Internal Subpages (Max Depth: 2)
            </label>
          </div>

          <div style="margin-top: 14px;">
            <CapCaptcha />
          </div>
        </form>

        <!-- Live Scan Status Overview -->
        <div
          id="scan-stats-card"
          style="display: none; margin-top: 24px; padding: 18px; border-radius: 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);"
        >
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px;">
            <div>
              <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Total Checked</div>
              <div id="stat-total" style="font-size: 1.6rem; font-weight: bold; margin-top: 4px;">0</div>
            </div>
            <div>
              <div style="font-size: 0.75rem; color: var(--green); text-transform: uppercase; letter-spacing: 0.05em;">2xx Successful</div>
              <div id="stat-2xx" style="font-size: 1.6rem; font-weight: bold; color: var(--green); margin-top: 4px;">0</div>
            </div>
            <div>
              <div style="font-size: 0.75rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em;">3xx Redirects</div>
              <div id="stat-3xx" style="font-size: 1.6rem; font-weight: bold; color: var(--accent); margin-top: 4px;">0</div>
            </div>
            <div>
              <div style="font-size: 0.75rem; color: var(--red); text-transform: uppercase; letter-spacing: 0.05em;">Broken / Errors</div>
              <div id="stat-broken" style="font-size: 1.6rem; font-weight: bold; color: var(--red); margin-top: 4px;">0</div>
            </div>
          </div>
        </div>

        <!-- Filter and Search Bar -->
        <div id="table-controls" class="tool-filter-bar" style="display: none;">
          <div class="tool-filter-group">
            <button type="button" class="filter-pill active filter-status-btn" data-filter="all">
              All <span class="filter-badge" id="badge-count-all">0</span>
            </button>
            <button type="button" class="filter-pill filter-status-btn" data-filter="2xx">
              2xx OK <span class="filter-badge" id="badge-count-2xx">0</span>
            </button>
            <button type="button" class="filter-pill filter-status-btn" data-filter="3xx">
              3xx Redirect <span class="filter-badge" id="badge-count-3xx">0</span>
            </button>
            <button type="button" class="filter-pill filter-pill-danger filter-status-btn" data-filter="broken">
              Broken <span class="filter-badge" id="badge-count-broken">0</span>
            </button>
          </div>

          <div class="search-input-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              id="table-search"
              type="text"
              class="tool-search-input"
              placeholder="Search links, URLs, sources..."
            />
            <button type="button" id="btn-clear-search" class="search-clear-btn" title="Clear search">✕</button>
          </div>
        </div>

        <!-- Results Counter -->
        <div id="results-count-bar" class="table-results-counter" style="display: none;">
          <span>Showing <strong id="visible-count">0</strong> of <span id="total-results-count">0</span> links</span>
        </div>

        <!-- Results Table -->
        <div id="results-table-container" class="results-table-container" style="display: none;">
          <table class="results-table">
            <thead>
              <tr>
                <th style="width: 100px;">Status</th>
                <th>Target URL</th>
                <th>Discovered On (Source)</th>
                <th style="width: 90px;">Tag</th>
                <th style="width: 90px;">Latency</th>
              </tr>
            </thead>
            <tbody id="results-tbody"></tbody>
          </table>
        </div>

        <!-- Empty State -->
        <div id="empty-results-state" class="tool-empty-state" style="display: none;">
          <div class="tool-empty-state-icon">🔍</div>
          <div class="tool-empty-state-title">No matching links found</div>
          <div class="tool-empty-state-text">Try adjusting your search keyword or switching the status filter tab.</div>
          <button type="button" id="btn-reset-filters" class="tool-empty-state-btn">Reset Filters</button>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { validateCaptcha, getCaptchaToken } from '@/lib/captcha';

  interface ResultItem {
    url: string;
    sourceUrl?: string;
    tag?: string;
    status: number;
    time?: number;
  }

  const form = document.getElementById('linkradar-form') as HTMLFormElement;
  const urlInput = document.getElementById('targetUrl') as HTMLInputElement;
  const btnStart = document.getElementById('btn-start-scan');
  const btnStop = document.getElementById('btn-stop-scan');
  const optCrawl = document.getElementById('opt-crawl') as HTMLInputElement;

  const statsCard = document.getElementById('scan-stats-card');
  const statTotal = document.getElementById('stat-total');
  const stat2xx = document.getElementById('stat-2xx');
  const stat3xx = document.getElementById('stat-3xx');
  const statBroken = document.getElementById('stat-broken');

  const badgeCountAll = document.getElementById('badge-count-all');
  const badgeCount2xx = document.getElementById('badge-count-2xx');
  const badgeCount3xx = document.getElementById('badge-count-3xx');
  const badgeCountBroken = document.getElementById('badge-count-broken');

  const tableControls = document.getElementById('table-controls');
  const resultsCountBar = document.getElementById('results-count-bar');
  const visibleCountEl = document.getElementById('visible-count');
  const totalResultsCountEl = document.getElementById('total-results-count');
  const tableContainer = document.getElementById('results-table-container');
  const emptyState = document.getElementById('empty-results-state');
  const tbody = document.getElementById('results-tbody');
  const searchInput = document.getElementById('table-search') as HTMLInputElement;
  const btnClearSearch = document.getElementById('btn-clear-search');
  const btnResetFilters = document.getElementById('btn-reset-filters');
  const filterBtns = document.querySelectorAll('.filter-status-btn');

  let activeFilter = 'all';
  let isScanning = false;
  let abortCtrl: AbortController | null = null;
  let allResults: ResultItem[] = [];

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.removeAttribute('data-active');
      });
      btn.classList.add('active');
      btn.setAttribute('data-active', 'true');
      activeFilter = (btn as HTMLElement).dataset.filter || 'all';
      renderTable();
    });
  });

  searchInput?.addEventListener('input', () => {
    if (btnClearSearch) {
      btnClearSearch.style.display = searchInput.value ? 'inline-block' : 'none';
    }
    renderTable();
  });

  btnClearSearch?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      btnClearSearch.style.display = 'none';
      renderTable();
      searchInput.focus();
    }
  });

  btnResetFilters?.addEventListener('click', () => {
    activeFilter = 'all';
    filterBtns.forEach((b) => {
      if ((b as HTMLElement).dataset.filter === 'all') {
        b.classList.add('active');
      } else {
        b.classList.remove('active');
      }
    });
    if (searchInput) {
      searchInput.value = '';
      if (btnClearSearch) btnClearSearch.style.display = 'none';
    }
    renderTable();
  });

  function renderTable() {
    if (!tbody) return;
    const query = (searchInput?.value || '').toLowerCase().trim();

    const filtered = allResults.filter((item) => {
      if (activeFilter === '2xx' && (item.status < 200 || item.status >= 300)) return false;
      if (activeFilter === '3xx' && (item.status < 300 || item.status >= 400)) return false;
      if (activeFilter === 'broken' && item.status >= 200 && item.status < 400) return false;

      if (query && !item.url.toLowerCase().includes(query) && !(item.sourceUrl || '').toLowerCase().includes(query) && !(item.tag || '').toLowerCase().includes(query) && !String(item.status).includes(query)) {
        return false;
      }
      return true;
    });

    if (visibleCountEl) visibleCountEl.textContent = String(filtered.length);
    if (totalResultsCountEl) totalResultsCountEl.textContent = String(allResults.length);

    if (allResults.length > 0) {
      if (resultsCountBar) resultsCountBar.style.display = 'flex';
    }

    if (filtered.length === 0 && allResults.length > 0) {
      if (tableContainer) tableContainer.style.display = 'none';
      if (emptyState) emptyState.style.display = 'flex';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';
    if (tableContainer) tableContainer.style.display = 'block';

    tbody.innerHTML = filtered
      .map((item) => {
        const isOk = item.status >= 200 && item.status < 300;
        const isRedirect = item.status >= 300 && item.status < 400;
        const color = isOk ? 'var(--green)' : isRedirect ? 'var(--accent)' : 'var(--red)';
        const bg = isOk ? 'rgba(52, 211, 153, 0.12)' : isRedirect ? 'rgba(129, 140, 248, 0.12)' : 'rgba(248, 113, 113, 0.12)';

        return `
        <tr>
          <td>
            <span style="display: inline-block; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-family: var(--font-mono); font-size: 0.78rem; background: ${bg}; color: ${color};">
              ${item.status || 'ERR'}
            </span>
          </td>
          <td style="font-family: var(--font-mono); max-width: 380px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <a href="${item.url}" target="_blank" rel="noopener noreferrer" style="color: var(--accent); display: inline-flex; align-items: center; gap: 4px;">
              <span>${item.url}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.7; flex-shrink: 0;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </td>
          <td style="font-family: var(--font-mono); color: var(--text-muted); max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.82rem;">
            ${item.sourceUrl || 'Root'}
          </td>
          <td>
            <span style="padding: 2px 6px; border-radius: 4px; background: rgba(255, 255, 255, 0.05); font-size: 0.72rem; text-transform: uppercase; font-weight: 600; color: var(--text-muted);">
              ${item.tag || 'LINK'}
            </span>
          </td>
          <td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">${item.time ? `${item.time}ms` : '—'}</td>
        </tr>
      `;
      })
      .join('');
  }

  function updateStats() {
    let s200 = 0;
    let s300 = 0;
    let sBroken = 0;

    allResults.forEach((r) => {
      if (r.status >= 200 && r.status < 300) s200++;
      else if (r.status >= 300 && r.status < 400) s300++;
      else sBroken++;
    });

    if (statTotal) statTotal.textContent = String(allResults.length);
    if (stat2xx) stat2xx.textContent = String(s200);
    if (stat3xx) stat3xx.textContent = String(s300);
    if (statBroken) statBroken.textContent = String(sBroken);

    if (badgeCountAll) badgeCountAll.textContent = String(allResults.length);
    if (badgeCount2xx) badgeCount2xx.textContent = String(s200);
    if (badgeCount3xx) badgeCount3xx.textContent = String(s300);
    if (badgeCountBroken) badgeCountBroken.textContent = String(sBroken);
  }

  async function checkUrl(url: string, sourceUrl?: string, tag?: string) {
    try {
      const token = getCaptchaToken(form);
      const tokenParam = token ? `&token=${encodeURIComponent(token)}` : '';
      const res = await fetch(`/api/check-url?url=${encodeURIComponent(url)}${tokenParam}`, { signal: abortCtrl?.signal });
      const json = await res.json();
      return {
        url,
        sourceUrl,
        tag,
        status: json.status || (res.ok ? 200 : 500),
        time: json.time,
        html: json.html || json.body || '',
      };
    } catch {
      return {
        url,
        sourceUrl,
        tag,
        status: 0,
      };
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const raw = urlInput?.value.trim();
    if (!raw) return;

    const { valid } = validateCaptcha(form);
    if (!valid) return;

    isScanning = true;
    allResults = [];
    abortCtrl = new AbortController();

    if (btnStart) btnStart.style.display = 'none';
    if (btnStop) btnStop.style.display = 'inline-block';
    if (statsCard) statsCard.style.display = 'block';
    if (tableControls) tableControls.style.display = 'flex';
    if (tableContainer) tableContainer.style.display = 'block';

    const origin = raw.startsWith('http') ? raw : `https://${raw}`;
    const visited = new Set<string>();
    const queue = [{ url: origin, depth: 0, sourceUrl: 'Entry', tag: 'A' }];

    while (queue.length > 0 && isScanning) {
      const item = queue.shift();
      if (!item || visited.has(item.url)) continue;
      visited.add(item.url);

      const res = await checkUrl(item.url, item.sourceUrl, item.tag);
      allResults.push(res);
      updateStats();
      renderTable();

      // If internal page and depth < 2, parse links
      if (optCrawl?.checked && item.depth < 2 && res.html && res.url.startsWith(new URL(origin).origin)) {
        const matches = res.html.matchAll(/href=["']([^"']+)["']/g);
        for (const m of matches) {
          const foundUrl = m[1];
          if (foundUrl.startsWith('#') || foundUrl.startsWith('javascript:') || foundUrl.startsWith('mailto:')) continue;
          try {
            const absolute = new URL(foundUrl, res.url).href;
            if (!visited.has(absolute)) {
              queue.push({ url: absolute, depth: item.depth + 1, sourceUrl: res.url, tag: 'A' });
            }
          } catch {
            // ignore malformed URL
          }
        }
      }
    }

    isScanning = false;
    if (btnStart) btnStart.style.display = 'inline-block';
    if (btnStop) btnStop.style.display = 'none';
  });

  btnStop?.addEventListener('click', () => {
    isScanning = false;
    abortCtrl?.abort();
    if (btnStart) btnStart.style.display = 'inline-block';
    if (btnStop) btnStop.style.display = 'none';
  });
</script>
