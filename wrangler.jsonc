{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "iqverse-net",
	"compatibility_date": "2026-04-06",
	"pages_build_output_dir": "out",
	"workers_dev": false,
	"observability": {
		"enabled": true,
	},
	"assets": {
		"directory": ".",
	},
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "iqverse.net/*",
			"zone_name": "iqverse.net",
		},
	],
	"env": {
		"production": {
			"routes": [
				{
					"pattern": "iqverse.net/*",
					"zone_name": "iqverse.net",
				},
			],
		},
	},
}
