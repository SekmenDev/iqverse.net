---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';
import { SAMPLE_WEBHOOKS } from '@/lib/webhook';
---

<ToolLayout
  title="Webhook Inspector & Signature Verifier"
  subtitle="Inspect Payload Bodies, Headers & HMAC Signatures"
  pill="BROWSER TOOLS"
  toolSlug="webhook-inspector"
  description="Inspect incoming webhook payloads, debug HTTP headers and verify HMAC SHA-256 signatures for GitHub, Stripe and custom webhooks."
>
  <div style="max-width: 1050px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 16px; flex-wrap: wrap;">
          <span style="font-size: 0.875rem; font-weight: 600;">Load Sample Payload:</span>
          {Object.keys(SAMPLE_WEBHOOKS).map((name) => (
            <button
              type="button"
              class="sample-wh-btn"
              data-name={name}
              style="font-size: 0.8rem; padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer;"
            >
              {name} Webhook
            </button>
          ))}
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 20px;">
          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="whHeaders">
              HTTP Request Headers
            </label>
            <textarea
              id="whHeaders"
              class={sharedStyles.textarea}
              rows="10"
              style="font-family: monospace;"
            >{SAMPLE_WEBHOOKS.GitHub.headers}</textarea>
          </div>

          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="whBody">
              Webhook Payload (JSON Body)
            </label>
            <textarea
              id="whBody"
              class={sharedStyles.textarea}
              rows="10"
              style="font-family: monospace;"
            >{SAMPLE_WEBHOOKS.GitHub.body}</textarea>
          </div>
        </div>

        <!-- Signature Verifier -->
        <div
          style="padding: 16px; border-radius: 8px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);"
        >
          <h4 style="margin: 0 0 12px 0;">HMAC Signature Calculator & Verifier</h4>
          <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <input
              id="whSecretKey"
              type="password"
              value="secret_webhook_key_123"
              class={sharedStyles.input}
              placeholder="Enter Webhook Signing Secret"
              style="flex: 1; min-width: 220px;"
            />
            <button
              type="button"
              id="btn-verify-wh-sig"
              class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
            >
              Compute Signature Digest
            </button>
          </div>

          <div
            id="wh-sig-result"
            style="margin-top: 12px; padding: 10px; border-radius: 6px; background: rgba(0,0,0,0.3); font-family: monospace; font-size: 0.85rem; color: #4caf50; display: none;"
          ></div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script is:inline define:vars={{ SAMPLE_WEBHOOKS }}>
  const headersInput = document.getElementById('whHeaders');
  const bodyInput = document.getElementById('whBody');
  const secretInput = document.getElementById('whSecretKey');
  const btnVerify = document.getElementById('btn-verify-wh-sig');
  const resultBox = document.getElementById('wh-sig-result');
  const sampleBtns = document.querySelectorAll('.sample-wh-btn');

  sampleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.name;
      if (name && SAMPLE_WEBHOOKS[name]) {
        if (headersInput) headersInput.value = SAMPLE_WEBHOOKS[name].headers;
        if (bodyInput) bodyInput.value = SAMPLE_WEBHOOKS[name].body;
        if (resultBox) resultBox.style.display = 'none';
      }
    });
  });

  btnVerify?.addEventListener('click', async () => {
    if (!resultBox) return;
    try {
      const secret = secretInput?.value || '';
      const body = bodyInput?.value.trim() || '';

      const encoder = new TextEncoder();
      const keyData = encoder.encode(secret);
      const cryptoKey = await crypto.subtle.importKey(
        'raw',
        keyData,
        { name: 'HMAC', hash: 'SHA-256' },
        false,
        ['sign']
      );

      const bodyData = encoder.encode(body);
      const signatureBuffer = await crypto.subtle.sign('HMAC', cryptoKey, bodyData);
      const computedHex = Array.from(new Uint8Array(signatureBuffer))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');

      resultBox.textContent = `Computed HMAC SHA-256 Digest: sha256=${computedHex}`;
      resultBox.style.display = 'block';
    } catch (err) {
      resultBox.textContent = `Signature Verification Error: ${err.message}`;
      resultBox.style.display = 'block';
    }
  });
</script>
