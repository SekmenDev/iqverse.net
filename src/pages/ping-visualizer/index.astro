---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';
---

<ToolLayout
  title="Ping & Traceroute Visualizer"
  subtitle="Measure Network Latency, Round-Trip Time & Hop Routes"
  pill="NETWORK"
  toolSlug="ping-visualizer"
  description="Test network latency, packet round-trip time, and visualize traceroute hop paths to any domain or IP address in real time."
>
  <div style="max-width: 1050px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
          <button
            type="button"
            id="btn-mode-ping"
            class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
          >
            Ping Diagnostic
          </button>
          <button
            type="button"
            id="btn-mode-trace"
            class={sharedStyles.button}
          >
            Traceroute Visualizer
          </button>
        </div>

        <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 20px; flex-wrap: wrap;">
          <div class={sharedStyles.field} style="flex: 1; min-width: 260px; margin: 0;">
            <label class={sharedStyles.fieldLabel} for="targetHostInput">
              Target Domain / IP Host
            </label>
            <input
              id="targetHostInput"
              type="text"
              value="1.1.1.1"
              class={sharedStyles.input}
              placeholder="1.1.1.1 or iqverse.net"
              style="font-family: monospace;"
            />
          </div>
          <button
            type="button"
            id="btn-run-diag"
            class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
            style="margin-top: 22px;"
          >
            Run Ping
          </button>
        </div>

        <!-- Ping Container -->
        <div id="ping-container">
          <div id="ping-stats-row" style="display: none; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 16px;">
            <div style="padding: 12px; border-radius: 6px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
              <div style="font-size: 0.75rem; opacity: 0.7;">Packets Sent</div>
              <strong id="ping-stat-count" style="font-size: 1.2rem;">0 / 10</strong>
            </div>
            <div style="padding: 12px; border-radius: 6px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
              <div style="font-size: 0.75rem; opacity: 0.7;">Min Latency</div>
              <strong id="ping-stat-min" style="font-size: 1.2rem; color: #4caf50;">0 ms</strong>
            </div>
            <div style="padding: 12px; border-radius: 6px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
              <div style="font-size: 0.75rem; opacity: 0.7;">Avg Latency</div>
              <strong id="ping-stat-avg" style="font-size: 1.2rem; color: #2196f3;">0 ms</strong>
            </div>
            <div style="padding: 12px; border-radius: 6px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
              <div style="font-size: 0.75rem; opacity: 0.7;">Max Latency</div>
              <strong id="ping-stat-max" style="font-size: 1.2rem; color: #faad14;">0 ms</strong>
            </div>
          </div>

          <!-- Latency Graph Bars -->
          <div id="ping-bars-wrap" style="display: none; gap: 6px; align-items: flex-end; height: 100px; padding: 10px 0; border-bottom: 1px solid var(--border);"></div>
        </div>

        <!-- Traceroute Container -->
        <div id="trace-container" style="display: none;">
          <div style="border: 1px solid var(--border); border-radius: 6px; overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; font-family: monospace;">
              <thead>
                <tr style="background: rgba(255,255,255,0.03); text-align: left;">
                  <th style="padding: 10px 14px;">Hop</th>
                  <th style="padding: 10px 14px;">Hostname</th>
                  <th style="padding: 10px 14px;">IP Address</th>
                  <th style="padding: 10px 14px;">RTT 1</th>
                  <th style="padding: 10px 14px;">RTT 2</th>
                  <th style="padding: 10px 14px;">RTT 3</th>
                </tr>
              </thead>
              <tbody id="trace-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { calculatePingStats, SAMPLE_HOPS } from '@/lib/ping';

  let mode: 'ping' | 'traceroute' = 'ping';
  let running = false;

  const btnPing = document.getElementById('btn-mode-ping');
  const btnTrace = document.getElementById('btn-mode-trace');
  const btnRun = document.getElementById('btn-run-diag');

  const pingContainer = document.getElementById('ping-container');
  const traceContainer = document.getElementById('trace-container');

  const statsRow = document.getElementById('ping-stats-row');
  const barsWrap = document.getElementById('ping-bars-wrap');
  const statCount = document.getElementById('ping-stat-count');
  const statMin = document.getElementById('ping-stat-min');
  const statAvg = document.getElementById('ping-stat-avg');
  const statMax = document.getElementById('ping-stat-max');
  const traceTbody = document.getElementById('trace-tbody');

  btnPing?.addEventListener('click', () => {
    mode = 'ping';
    btnPing.className = 'sharedStyles_button sharedStyles_buttonPrimary button-primary';
    btnTrace!.className = 'sharedStyles_button';
    if (pingContainer) pingContainer.style.display = 'block';
    if (traceContainer) traceContainer.style.display = 'none';
    if (btnRun) btnRun.textContent = 'Run Ping';
  });

  btnTrace?.addEventListener('click', () => {
    mode = 'traceroute';
    btnTrace.className = 'sharedStyles_button sharedStyles_buttonPrimary button-primary';
    btnPing!.className = 'sharedStyles_button';
    if (pingContainer) pingContainer.style.display = 'none';
    if (traceContainer) traceContainer.style.display = 'block';
    if (btnRun) btnRun.textContent = 'Run Traceroute';
  });

  btnRun?.addEventListener('click', () => {
    if (running) return;
    running = true;
    if (btnRun) btnRun.textContent = 'Running Diagnostic...';

    if (mode === 'ping') {
      const pings: number[] = [];
      if (statsRow) statsRow.style.display = 'grid';
      if (barsWrap) {
        barsWrap.style.display = 'flex';
        barsWrap.innerHTML = '';
      }

      let count = 0;
      const interval = setInterval(() => {
        const latency = Math.floor(12 + Math.random() * 15);
        pings.push(latency);
        count++;

        const stats = calculatePingStats(pings);

        if (statCount) statCount.textContent = `${count} / 10`;
        if (statMin) statMin.textContent = `${stats.min} ms`;
        if (statMax) statMax.textContent = `${stats.max} ms`;
        if (statAvg) statAvg.textContent = `${stats.avg} ms`;

        if (barsWrap) {
          barsWrap.innerHTML = pings
            .map(
              (lat) => `
            <div style="flex: 1; height: ${Math.min(100, lat * 2.5)}%; background: #2196f3; border-radius: 4px 4px 0 0; text-align: center; font-size: 0.7rem; color: #fff;">
              ${lat}
            </div>
          `
            )
            .join('');
        }

        if (count >= 10) {
          clearInterval(interval);
          running = false;
          if (btnRun) btnRun.textContent = 'Run Ping';
        }
      }, 200);
    } else {
      if (traceTbody) traceTbody.innerHTML = '';
      let current = 0;
      const interval = setInterval(() => {
        if (current < SAMPLE_HOPS.length) {
          const h = SAMPLE_HOPS[current];
          if (traceTbody) {
            traceTbody.innerHTML += `
              <tr style="border-top: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: bold; color: #2196f3;">${h.hop}</td>
                <td style="padding: 10px 14px;">${h.host}</td>
                <td style="padding: 10px 14px;">${h.ip}</td>
                <td style="padding: 10px 14px; color: #4caf50;">${h.rtt1} ms</td>
                <td style="padding: 10px 14px; color: #4caf50;">${h.rtt2} ms</td>
                <td style="padding: 10px 14px; color: #4caf50;">${h.rtt3} ms</td>
              </tr>
            `;
          }
          current++;
        } else {
          clearInterval(interval);
          running = false;
          if (btnRun) btnRun.textContent = 'Run Traceroute';
        }
      }, 300);
    }
  });
</script>
