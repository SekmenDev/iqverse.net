{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*", "./*"]
    },
    "types": ["astro/client", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "lib/**/*",
    "functions/**/*",
    "__tests__/unit/**/*",
    "e2e/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "out"
  ]
}
