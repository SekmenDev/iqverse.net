---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const AMBIGUOUS = '{}[]()/\\\'"`~,;:.<>?';
---

<ToolLayout
  title="Password Generator"
  subtitle="Cryptographic Password Generator"
  pill="SECURITY"
  toolSlug="password"
  description="Generate cryptographically secure passwords, API keys and secret tokens locally with entropy evaluation and zero network calls."
>
  <div style="max-width: 1000px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.sectionLabel}>Password Generator</div>
      <div class={sharedStyles.card}>
        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="pwdLength" id="pwdLengthLabel">Length: 20</label>
          <input
            id="pwdLength"
            type="range"
            min="4"
            max="128"
            value="20"
            style="width: 100%;"
          />
        </div>

        <div class={sharedStyles.field}>
          <div class={sharedStyles.fieldLabel}>Character sets</div>
          <div style="display: grid; gap: 0.75rem;">
            <label for="useUpper">
              <input id="useUpper" type="checkbox" checked /> Uppercase (A-Z)
            </label>
            <label for="useLower">
              <input id="useLower" type="checkbox" checked /> Lowercase (a-z)
            </label>
            <label for="useDigits">
              <input id="useDigits" type="checkbox" checked /> Digits (0-9)
            </label>
            <label for="useSymbols">
              <input id="useSymbols" type="checkbox" checked /> Symbols
            </label>
          </div>
        </div>

        <div class={sharedStyles.field}>
          <div class={sharedStyles.fieldLabel}>Filters</div>
          <div style="display: grid; gap: 0.75rem;">
            <label for="excludeSimilar">
              <input id="excludeSimilar" type="checkbox" /> Exclude similar characters (0Oo1IlL)
            </label>
            <label for="excludeAmbiguous">
              <input id="excludeAmbiguous" type="checkbox" /> Exclude ambiguous characters ({AMBIGUOUS})
            </label>
          </div>
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="customSymbols">Custom symbols</label>
          <input
            id="customSymbols"
            type="text"
            placeholder="Leave blank for default symbols"
            class={sharedStyles.input}
          />
        </div>

        <div class={sharedStyles.field}>
          <div class={sharedStyles.fieldLabel}>Prefix / Suffix</div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem;">
            <div>
              <label for="pwdPrefix" class={sharedStyles.fieldLabel}>Prefix</label>
              <input
                id="pwdPrefix"
                type="text"
                placeholder="Prefix"
                class={sharedStyles.input}
              />
            </div>
            <div>
              <label for="pwdSuffix" class={sharedStyles.fieldLabel}>Suffix</label>
              <input
                id="pwdSuffix"
                type="text"
                placeholder="Suffix"
                class={sharedStyles.input}
              />
            </div>
          </div>
        </div>

        <div class={sharedStyles.field}>
          <div class={sharedStyles.fieldLabel}>Minimum counts</div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem;">
            <div>
              <label for="minUpper" class={sharedStyles.fieldLabel}>Uppercase min</label>
              <input
                id="minUpper"
                type="number"
                min="0"
                max="128"
                value="1"
                class={sharedStyles.input}
              />
            </div>
            <div>
              <label for="minLower" class={sharedStyles.fieldLabel}>Lowercase min</label>
              <input
                id="minLower"
                type="number"
                min="0"
                max="128"
                value="1"
                class={sharedStyles.input}
              />
            </div>
            <div>
              <label for="minDigits" class={sharedStyles.fieldLabel}>Digits min</label>
              <input
                id="minDigits"
                type="number"
                min="0"
                max="128"
                value="1"
                class={sharedStyles.input}
              />
            </div>
            <div>
              <label for="minSymbols" class={sharedStyles.fieldLabel}>Symbols min</label>
              <input
                id="minSymbols"
                type="number"
                min="0"
                max="128"
                value="1"
                class={sharedStyles.input}
              />
            </div>
          </div>
        </div>

        <div class={sharedStyles.buttonGroup}>
          <button type="button" id="btn-generate" class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}>
            Generate Password
          </button>
          <button type="button" id="btn-clear" class={`${sharedStyles.button} ${sharedStyles.buttonSecondary}`}>
            Clear
          </button>
        </div>
      </div>
    </section>

    <section id="error-section" class={sharedStyles.section} style="display: none;">
      <div class={sharedStyles.sectionLabel}>Error</div>
      <div class={sharedStyles.errorCard}>
        <div id="error-message" class={sharedStyles.errorMessage}></div>
      </div>
    </section>

    <section id="output-section" class={sharedStyles.section} style="display: none;">
      <div class={sharedStyles.sectionLabel}>Generated Password</div>
      <div class={sharedStyles.card}>
        <textarea id="pwdOutput" readonly class={sharedStyles.outputArea} rows="4"></textarea>
        <button type="button" id="btn-copy" class={`${sharedStyles.button} ${sharedStyles.buttonSmall}`}>
          Copy
        </button>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { generatePassword } from '@/lib/password';

  const lengthInput = document.getElementById('pwdLength') as HTMLInputElement;
  const lengthLabel = document.getElementById('pwdLengthLabel');
  const upperCb = document.getElementById('useUpper') as HTMLInputElement;
  const lowerCb = document.getElementById('useLower') as HTMLInputElement;
  const digitsCb = document.getElementById('useDigits') as HTMLInputElement;
  const symbolsCb = document.getElementById('useSymbols') as HTMLInputElement;
  const simCb = document.getElementById('excludeSimilar') as HTMLInputElement;
  const ambCb = document.getElementById('excludeAmbiguous') as HTMLInputElement;
  const customSymInput = document.getElementById('customSymbols') as HTMLInputElement;
  const prefixInput = document.getElementById('pwdPrefix') as HTMLInputElement;
  const suffixInput = document.getElementById('pwdSuffix') as HTMLInputElement;
  const minUpperInput = document.getElementById('minUpper') as HTMLInputElement;
  const minLowerInput = document.getElementById('minLower') as HTMLInputElement;
  const minDigitsInput = document.getElementById('minDigits') as HTMLInputElement;
  const minSymbolsInput = document.getElementById('minSymbols') as HTMLInputElement;

  const btnGenerate = document.getElementById('btn-generate');
  const btnClear = document.getElementById('btn-clear');
  const btnCopy = document.getElementById('btn-copy');
  const errorSection = document.getElementById('error-section');
  const errorMsg = document.getElementById('error-message');
  const outputSection = document.getElementById('output-section');
  const pwdOutput = document.getElementById('pwdOutput') as HTMLTextAreaElement;

  if (lengthInput && lengthLabel) {
    lengthInput.addEventListener('input', () => {
      lengthLabel.textContent = `Length: ${lengthInput.value}`;
    });
  }

  function showError(msg: string) {
    if (errorSection && errorMsg && outputSection) {
      errorMsg.textContent = msg;
      errorSection.style.display = 'block';
      outputSection.style.display = 'none';
    }
  }

  function hideError() {
    if (errorSection) {
      errorSection.style.display = 'none';
    }
  }

  function handleGeneratePassword() {
    hideError();
    try {
      const result = generatePassword({
        length: Number(lengthInput?.value || 20),
        useUpper: upperCb?.checked || false,
        useLower: lowerCb?.checked || false,
        useDigits: digitsCb?.checked || false,
        useSymbols: symbolsCb?.checked || false,
        excludeSimilar: simCb?.checked || false,
        excludeAmbiguous: ambCb?.checked || false,
        customSymbols: customSymInput?.value.trim() || undefined,
        prefix: prefixInput?.value || '',
        suffix: suffixInput?.value || '',
        minUpper: Number(minUpperInput?.value || 0),
        minLower: Number(minLowerInput?.value || 0),
        minDigits: Number(minDigitsInput?.value || 0),
        minSymbols: Number(minSymbolsInput?.value || 0),
      });

      if (pwdOutput && outputSection) {
        pwdOutput.value = result;
        outputSection.style.display = 'block';
      }
    } catch (err: any) {
      showError(err.message || 'Unable to generate password.');
    }
  }

  btnGenerate?.addEventListener('click', handleGeneratePassword);

  btnClear?.addEventListener('click', () => {
    hideError();
    if (outputSection && pwdOutput) {
      outputSection.style.display = 'none';
      pwdOutput.value = '';
    }
  });

  btnCopy?.addEventListener('click', async () => {
    if (pwdOutput?.value && btnCopy) {
      await navigator.clipboard.writeText(pwdOutput.value);
      const prev = btnCopy.textContent;
      btnCopy.textContent = 'Copied!';
      setTimeout(() => {
        btnCopy.textContent = prev;
      }, 1500);
    }
  });
</script>
