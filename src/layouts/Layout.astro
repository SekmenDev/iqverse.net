.----)   |   |  |____ |  .  \  |  |  |  | |  |____ |  |\   |  __|  '--'  ||  |____   \    /
|_______/    |_______||__|\__\ |__|  |__| |_______||__| \__| (__)_______/ |_______|   \__/-->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0C0E14" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
    <meta name="robots" content="index, follow" />

    <title>{formattedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={formattedCanonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={formattedCanonical} />
    <meta property="og:site_name" content="IQVerse" />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://iqverse.net${ogImage}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://iqverse.net${ogImage}`} />

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Theme Initialization Script (Instant, Zero-FOUC) -->
    <script is:inline>
      (function() {
        try {
          const saved = localStorage.getItem('iqverse-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch {
          // ignore localStorage access errors
        }
      })();
    </script>

    <!-- External Widgets -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/cap-widget@latest" type="module"></script>

    <!-- Structured Data JSON-LD -->
    <script is:inline type="application/ld+json" set:html={jsonLdString} />
  </head>
  <body>
    <slot />

    {!hideDefaultFooter && (
      <footer class="pageFooter">
        <span class="footerNote">
          Made with ❤️ by <a href="https://sekmen.dev" target="_blank" rel="noopener">Sekmen.Dev</a> and published on <a href="https://github.com/SekmenDev/iqverse.net" target="_blank" rel="noopener">Github</a>
        </span>
        <span class="footerNote">
          Open source. MIT License. No servers. No tracking. No cost.
        </span>
      </footer>
    )}
  </body>
</html>
