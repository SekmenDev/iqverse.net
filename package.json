{
  "name": "iqverse",
  "version": "1.0.0",
  "description": "IQVerse - Free open-source developer tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.2",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.7.0",
    "jsdom": "^26.1.0",
    "typescript": "6.0.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "yarn@4.9.1"
}
