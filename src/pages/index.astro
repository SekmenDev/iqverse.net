---
import Layout from '@/layouts/Layout.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import ToolNavSearch from '@/components/ToolNavSearch.astro';
import ToolCard from '@/components/ToolCard.astro';
import {
  CATEGORY_ICONS,
  STATUS_ICONS,
  STATUS_LABELS,
  countByCategory,
  countByStatus,
  getUniqueCategories,
  getUniqueStatuses,
  groupByPrimaryCategory,
  tools,
  type ToolType,
} from '@/lib/tools';
import { getToolsCollectionJsonLd } from '@/lib/jsonld';
import styles from '@/styles/catalog.module.css';

const categories = getUniqueCategories();
const statuses = getUniqueStatuses();
const catCounts = countByCategory();
const statusCounts = countByStatus();
const groups = groupByPrimaryCategory();

const DOT_CLASS: Record<ToolType, string> = {
  open: styles.dotOpen,
  saas: styles.dotSaas,
  coming: styles.dotComing,
};

const jsonLdData = getToolsCollectionJsonLd();
---

<Layout
  title="IQVerse | Free Open-Source Online Developer Tools & Utilities"
  description="IQVerse offers free, open-source browser-based developer tools for AI agent scanning, QR generation, link checking, favicon creation, JSON validation, CSS conversion, image optimization and more. All running locally in your browser with no login, no telemetry and no cost."
  canonicalUrl="https://iqverse.net/"
  jsonLd={jsonLdData}
>
  <div class={styles.container}>
    <!-- TOP NAV -->
    <nav class={styles.topNav}>
      <button
        type="button"
        id="menu-toggle-btn"
        class={styles.menuToggle}
        aria-label="Toggle menu"
      >
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 5h14M3 10h14M3 15h14" />
        </svg>
      </button>

      <a href="/" class={styles.navLogo}>
        <ThemeToggle />
        <span>IQVerse</span>
      </a>

      <ToolNavSearch mode="filter" />

      <div class={styles.navRight}>
        <a
          href="https://github.com/SekmenDev/iqverse.net"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          GitHub
        </a>
      </div>
    </nav>

    <button type="button" id="sidebar-overlay" class={styles.sidebarOverlay} aria-hidden="true" />

    <div class={styles.layout}>
      <!-- SIDEBAR -->
      <nav class={styles.sidebar} id="sidebar" aria-label="Tool categories">
        <span class={styles.sidebarLabel}>Categories</span>
        <div id="cat-filters">
          {categories.map(cat => (
            <button
              type="button"
              class={styles.catBtn}
              data-cat={cat}
              aria-pressed={cat === 'all' ? 'true' : 'false'}
            >
              <span class={styles.catIcon}>{cat === 'all' ? '⊞' : CATEGORY_ICONS[cat]}</span>
              <span style="flex: 1; text-align: left;">{cat === 'all' ? 'All Tools' : cat}</span>
              <span class={styles.catCount}>{catCounts[cat]}</span>
            </button>
          ))}
        </div>

        <span class={styles.sidebarLabel}>Status</span>
        <div id="status-filters">
          {statuses.map(s => (
            <button
              type="button"
              class={styles.catBtn}
              data-status={s}
              aria-pressed={s === 'all' ? 'true' : 'false'}
            >
              <span class={`${styles.catIcon} ${s !== 'all' ? DOT_CLASS[s] : ''}`}>
                {s === 'all' ? '⊞' : STATUS_ICONS[s]}
              </span>
              <span style="flex: 1; text-align: left;">{s === 'all' ? 'All' : STATUS_LABELS[s]}</span>
              <span class={styles.catCount}>{statusCounts[s]}</span>
            </button>
          ))}
        </div>
      </nav>

      <!-- MAIN -->
      <main class={styles.main} id="main-content">
        <h1 class="sr-only">IQVerse Developer Tools & Utilities</h1>
        <div class={styles.toolbar}>
          <span class={styles.resultCount} id="result-count">
            <strong>{tools.length}</strong> tools
          </span>
          <div class={styles.sortWrap} id="sort-filters" aria-label="Sort options">
            <button
              type="button"
              class={styles.sortBtn}
              data-sort="default"
              aria-pressed="true"
            >
              Default
            </button>
            <button
              type="button"
              class={styles.sortBtn}
              data-sort="az"
              aria-pressed="false"
            >
              A-Z
            </button>
          </div>
        </div>

        <div id="content-area">
          <div id="category-groups-container">
            {groups.map(({ category, tools: catTools }) => (
              <div class="category-group" data-group-cat={category}>
                <p class={styles.sectionHead}>
                  {CATEGORY_ICONS[category]} {category}
                </p>
                <div class={`card-grid-container ${styles.cardGrid}`}>
                  {catTools.map(tool => <ToolCard tool={tool} />)}
                </div>
              </div>
            ))}
          </div>

          <div id="flat-view" hidden>
            <p class={styles.flatHead}>
              <span id="flat-head-label"></span>
              <button type="button" id="clear-filters" class={styles.clearFilters}>
                Clear
              </button>
            </p>
            <div id="flat-grid" class={styles.cardGrid}></div>
          </div>

          <div id="catalog-empty-state" class={styles.empty} hidden>
            <div class={styles.emptyIcon}>🔍</div>
            <h3>No tools found</h3>
            <p>Try a different search or filter.</p>
            <div class={styles.suggestList} id="empty-suggestions"></div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script>
  import { highlight, searchTools, suggestTools, type SearchResult } from '@/lib/tool-search';
  import { CATEGORIES, STATUS_LABELS, type Category, type ToolType } from '@/lib/tools';
  import styles from '@/styles/catalog.module.css';

  type SortMode = 'default' | 'az';

  interface CatalogState {
    q: string;
    cat: Category | 'all';
    status: ToolType | 'all';
    sort: SortMode;
  }

  const STATUSES: ToolType[] = ['open', 'saas', 'coming'];

  function readState(): CatalogState {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('cat');
    const status = params.get('status');

    return {
      q: params.get('q') ?? '',
      cat: CATEGORIES.includes(cat as Category) ? (cat as Category) : 'all',
      status: STATUSES.includes(status as ToolType) ? (status as ToolType) : 'all',
      sort: params.get('sort') === 'az' ? 'az' : 'default',
    };
  }

  function queryView() {
    const groupsContainer = document.getElementById('category-groups-container');
    const flatView = document.getElementById('flat-view');
    const flatGrid = document.getElementById('flat-grid');
    const emptyState = document.getElementById('catalog-empty-state');

    if (!groupsContainer || !flatView || !flatGrid || !emptyState) return null;
    return { groupsContainer, flatView, flatGrid, emptyState };
  }

  function initCatalog() {
    const input = document.getElementById('tool-nav-search') as HTMLInputElement | null;
    const kbd = document.getElementById('tool-search-kbd');
    const searchClearBtn = document.getElementById('tool-search-clear') as HTMLButtonElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('#cat-filters button[data-cat]');
    const statusButtons = document.querySelectorAll<HTMLButtonElement>('#status-filters button[data-status]');
    const sortButtons = document.querySelectorAll<HTMLButtonElement>('#sort-filters button[data-sort]');
    const resultCountEl = document.getElementById('result-count');
    const flatLabel = document.getElementById('flat-head-label');
    const clearFiltersBtn = document.getElementById('clear-filters');
    const emptySuggestions = document.getElementById('empty-suggestions');
    const menuToggle = document.getElementById('menu-toggle-btn');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    const view = queryView();
    if (!view) return;
    const { groupsContainer, flatView, flatGrid, emptyState } = view;

    const cardOrder: string[] = [];
    const cards = new Map<string, HTMLElement>();
    const homeGrids = new Map<string, HTMLElement>();
    const originals = new Map<HTMLElement, { name: string; desc: string }>();
    const highlighted = new Set<HTMLElement>();

    document.querySelectorAll<HTMLElement>('.tool-card-item').forEach(card => {
      const key = card.dataset.key;
      const parent = card.parentElement;
      if (!key || !parent) return;
      cardOrder.push(key);
      cards.set(key, card);
      homeGrids.set(key, parent);
      originals.set(card, {
        name: card.querySelector('[data-field="name"]')?.textContent ?? '',
        desc: card.querySelector('[data-field="desc"]')?.textContent ?? '',
      });
    });

    const categoryGroups = Array.from(document.querySelectorAll<HTMLElement>('.category-group'));

    const state: CatalogState = readState();

    function writeState() {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.cat !== 'all') params.set('cat', state.cat);
      if (state.status !== 'all') params.set('status', state.status);
      if (state.sort !== 'default') params.set('sort', state.sort);

      const query = params.toString();
      window.history.replaceState(null, '', query ? `?${query}` : window.location.pathname);
    }

    function syncPressed(buttons: NodeListOf<HTMLButtonElement>, attr: string, value: string) {
      buttons.forEach(btn => {
        btn.setAttribute('aria-pressed', btn.dataset[attr] === value ? 'true' : 'false');
      });
    }

    function resetHighlights() {
      highlighted.forEach(card => {
        const plain = originals.get(card);
        if (!plain) return;
        const name = card.querySelector<HTMLElement>('[data-field="name"]');
        const desc = card.querySelector<HTMLElement>('[data-field="desc"]');
        if (name) name.textContent = plain.name;
        if (desc) desc.textContent = plain.desc;
      });
      highlighted.clear();
    }

    function paint(result: SearchResult, card: HTMLElement) {
      const name = card.querySelector<HTMLElement>('[data-field="name"]');
      const desc = card.querySelector<HTMLElement>('[data-field="desc"]');
      if (result.nameRanges.length === 0 && result.descRanges.length === 0) return;
      if (name) name.innerHTML = highlight(result.tool.name, result.nameRanges);
      if (desc) desc.innerHTML = highlight(result.tool.desc, result.descRanges);
      highlighted.add(card);
    }

    function escapeText(value: string): string {
      const holder = document.createElement('span');
      holder.textContent = value;
      return holder.innerHTML;
    }

    function describe(count: number): string {
      const noun = `tool${count === 1 ? '' : 's'}`;
      const parts: string[] = [];

      if (state.q) parts.push(`matching “${escapeText(state.q)}”`);
      if (state.cat !== 'all') parts.push(`in ${escapeText(state.cat)}`);
      if (state.status !== 'all') parts.push(STATUS_LABELS[state.status].toLowerCase());

      return `<strong>${count}</strong> ${noun}${parts.length ? ` ${parts.join(' · ')}` : ''}`;
    }

    function renderSuggestions() {
      if (!emptySuggestions) return;
      emptySuggestions.replaceChildren();
      if (!state.q) return;

      suggestTools(state.q).forEach(tool => {
        const link = document.createElement('a');
        link.href = tool.url;
        link.className = styles.suggestBtn;
        link.textContent = `${tool.icon} ${tool.name}`;
        emptySuggestions.appendChild(link);
      });
    }

    function render() {
      const results = searchTools(state.q, {
        category: state.cat,
        status: state.status,
        sort: state.sort,
      });

      const visible = new Map(results.map(result => [result.tool.url, result]));
      const grouped =
        !state.q && state.cat === 'all' && state.status === 'all' && state.sort === 'default';

      resetHighlights();

      if (grouped) {
        flatView.hidden = true;
        groupsContainer.hidden = results.length === 0;

        cardOrder.forEach(key => {
          const card = cards.get(key);
          const home = homeGrids.get(key);
          if (!card || !home) return;
          if (card.parentElement !== home) home.appendChild(card);
          card.style.display = visible.has(key) ? '' : 'none';
        });

        categoryGroups.forEach(group => {
          const hasVisible = Array.from(
            group.querySelectorAll<HTMLElement>('.tool-card-item')
          ).some(card => card.style.display !== 'none');
          group.hidden = !hasVisible;
        });
      } else {
        groupsContainer.hidden = true;
        flatView.hidden = results.length === 0;
        flatGrid.replaceChildren();

        results.forEach(result => {
          const card = cards.get(result.tool.url);
          if (!card) return;
          card.style.display = '';
          paint(result, card);
          flatGrid.appendChild(card);
        });

        if (flatLabel) flatLabel.innerHTML = describe(results.length);
      }

      emptyState.hidden = results.length > 0;
      if (results.length === 0) renderSuggestions();

      if (resultCountEl) {
        resultCountEl.innerHTML = `<strong>${results.length}</strong> tool${results.length === 1 ? '' : 's'}`;
      }

      if (searchClearBtn && kbd) {
        const hasQuery = state.q.length > 0;
        searchClearBtn.style.display = hasQuery ? 'inline-flex' : 'none';
        kbd.style.display = hasQuery ? 'none' : '';
      }

      syncPressed(catButtons, 'cat', state.cat);
      syncPressed(statusButtons, 'status', state.status);
      syncPressed(sortButtons, 'sort', state.sort);
    }

    function update(patch: Partial<CatalogState>) {
      Object.assign(state, patch);
      writeState();
      render();
    }

    function setQuery(value: string) {
      if (input) input.value = value;
      update({ q: value });
    }

    // Sidebar mobile toggle
    if (menuToggle && sidebar && overlay) {
      menuToggle.onclick = () => {
        sidebar.classList.toggle(styles.sidebarOpen);
        overlay.classList.toggle(styles.sidebarOverlayShow);
      };
      overlay.onclick = () => {
        sidebar.classList.remove(styles.sidebarOpen);
        overlay.classList.remove(styles.sidebarOverlayShow);
      };
    }

    if (input) {
      input.value = state.q;
      input.addEventListener('input', () => update({ q: input.value }));
      input.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          event.preventDefault();
          setQuery('');
        }
        if (event.key === 'Enter') {
          event.preventDefault();
          const top = searchTools(state.q, {
            category: state.cat,
            status: state.status,
            sort: state.sort,
            limit: 1,
          })[0];
          if (state.q && top) window.location.href = top.tool.url;
        }
      });
    }

    searchClearBtn?.addEventListener('click', event => {
      event.preventDefault();
      setQuery('');
      input?.focus();
    });

    window.addEventListener('keydown', event => {
      const target = event.target as HTMLElement | null;
      const isEditable =
        !!target &&
        (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));

      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !isEditable) {
        event.preventDefault();
        input?.focus();
        input?.select();
      }
    });

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => update({ cat: (btn.dataset.cat ?? 'all') as Category | 'all' }));
    });

    statusButtons.forEach(btn => {
      btn.addEventListener('click', () => update({ status: (btn.dataset.status ?? 'all') as ToolType | 'all' }));
    });

    sortButtons.forEach(btn => {
      btn.addEventListener('click', () => update({ sort: btn.dataset.sort === 'az' ? 'az' : 'default' }));
    });

    clearFiltersBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      update({ q: '', cat: 'all', status: 'all', sort: 'default' });
    });

    // Card chips: category chip filters, tag chip searches
    document.addEventListener('click', event => {
      const chip = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-filter-cat], [data-filter-tag]');
      if (!chip) return;

      event.preventDefault();
      const cat = chip.dataset.filterCat;
      const tag = chip.dataset.filterTag;

      if (cat) update({ cat: cat as Category });
      else if (tag) setQuery(tag);

      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    render();
  }

  initCatalog();
</script>
