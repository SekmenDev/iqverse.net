---
import { DEFAULT_CAPTCHA_ENDPOINT } from '@/lib/captcha';

export interface Props {
  endpoint?: string;
  workerCount?: number | string;
  disableHaptics?: boolean | string;
  resetOnSubmit?: boolean;
  required?: boolean;
  class?: string;
  style?: string;
  id?: string;
}

const {
  endpoint = DEFAULT_CAPTCHA_ENDPOINT,
  workerCount,
  disableHaptics,
  resetOnSubmit = true,
  required = true,
  class: className = '',
  style = '',
  id,
} = Astro.props;
---

<div class={`cap-captcha-wrap ${className}`.trim()} style={`display: inline-flex; flex-direction: column; align-items: flex-start; margin: 8px 0; ${style}`.trim()}>
  <cap-widget
    id={id}
    data-cap-api-endpoint={endpoint}
    data-cap-worker-count={workerCount}
    data-cap-disable-haptics={disableHaptics}
    data-cap-reset-on-submit={resetOnSubmit ? 'true' : 'false'}
    required={required}
  ></cap-widget>
  <div class="cap-captcha-error" style="display: none; color: #ff4d4f; font-size: 0.8rem; font-weight: 500; margin-top: 6px; font-family: var(--font-mono, monospace);">
    ⚠️ Please complete the CAPTCHA challenge before proceeding.
  </div>
</div>

<style>
  .cap-captcha-wrap {
    transition: transform 0.2s ease;
  }

  .cap-captcha-wrap.cap-invalid :global(cap-widget) {
    outline: 2px solid #ff4d4f;
    outline-offset: 2px;
    border-radius: 6px;
    animation: cap-shake 0.4s ease-in-out;
  }

  @keyframes cap-shake {
    0%, 100% {
      transform: translateX(0);
    }
    20%, 60% {
      transform: translateX(-6px);
    }
    40%, 80% {
      transform: translateX(6px);
    }
  }
</style>

<script>
  import { bindCapWidget } from '@/lib/captcha';

  function initCaptchaWidgets() {
    const widgets = document.querySelectorAll('cap-widget');
    widgets.forEach((widget) => {
      if ((widget as any).__cap_bound) return;
      (widget as any).__cap_bound = true;
      bindCapWidget(widget as HTMLElement);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCaptchaWidgets);
  } else {
    initCaptchaWidgets();
  }

  document.addEventListener('astro:page-load', initCaptchaWidgets);
  document.addEventListener('astro:after-swap', initCaptchaWidgets);
</script>
