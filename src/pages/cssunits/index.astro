---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const units = ['px', 'rem', 'em', 'vh', 'vw', '%'];
---

<ToolLayout
  title="CSS Units Converter"
  subtitle="Convert Pixels (px), rem, em, vh, vw & %"
  pill="DESIGN"
  toolSlug="cssunits"
  description="Convert CSS units between pixels (px), rem, em, viewports (vw/vh) and percentages with live responsive preview."
>
  <div style="max-width: 900px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.sectionLabel}>Converter</div>
      <div class={sharedStyles.card}>
        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="cssValue">Value</label>
          <input
            id="cssValue"
            type="number"
            value="16"
            class={sharedStyles.input}
          />
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="cssFrom">From Unit</label>
          <select id="cssFrom">
            {units.map((unit) => (
              <option value={unit} selected={unit === 'px'}>
                {unit}
              </option>
            ))}
          </select>
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="cssTo">To Unit</label>
          <select id="cssTo">
            {units.map((unit) => (
              <option value={unit} selected={unit === 'rem'}>
                {unit}
              </option>
            ))}
          </select>
        </div>

        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="cssRoot">Root Font Size (px)</label>
          <input
            id="cssRoot"
            type="number"
            value="16"
            class={sharedStyles.input}
          />
        </div>

        <div class={sharedStyles.sectionLabel} style="margin-top: 24px;">Result</div>
        <div class={sharedStyles.successCard}>
          <div id="css-unit-result" class={sharedStyles.successMessage}>1.000rem</div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { convertCssUnit, type CssUnit } from '@/lib/cssunits';

  const valInput = document.getElementById('cssValue') as HTMLInputElement;
  const fromSelect = document.getElementById('cssFrom') as HTMLSelectElement;
  const toSelect = document.getElementById('cssTo') as HTMLSelectElement;
  const rootInput = document.getElementById('cssRoot') as HTMLInputElement;
  const resultEl = document.getElementById('css-unit-result');

  function update() {
    if (!resultEl) return;
    const val = Number(valInput?.value || 0);
    const root = Number(rootInput?.value || 16);
    const fromUnit = (fromSelect?.value || 'px') as CssUnit;
    const toUnit = (toSelect?.value || 'rem') as CssUnit;

    if (Number.isNaN(val)) {
      resultEl.textContent = 'Please enter a valid number.';
      return;
    }
    if (Number.isNaN(root) || root <= 0) {
      resultEl.textContent = 'Root font size must be positive.';
      return;
    }

    const viewportWidth = window.innerWidth || 1000;
    const viewportHeight = window.innerHeight || 800;
    const converted = convertCssUnit(val, fromUnit, toUnit, root, viewportWidth, viewportHeight);
    resultEl.textContent = `${converted.toFixed(3)}${toUnit}`;
  }

  [valInput, fromSelect, toSelect, rootInput].forEach((el) => el?.addEventListener('input', update));
  update();
</script>
