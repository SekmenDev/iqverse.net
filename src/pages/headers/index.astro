---
import ToolLayout from "@/layouts/ToolLayout.astro";
import CapCaptcha from "@/components/CapCaptcha.astro";
import styles from "@/styles/header-scan.module.css";

const QUICK_EXAMPLES = [
  "https://iqverse.net",
  "https://cloudflare.com",
  "https://github.com",
  "https://google.com",
  "https://stripe.com",
];

const HEADERS_GUIDE = [
  {
    name: "Content-Security-Policy",
    short: "CSP",
    importance: "Critical (Security)",
    desc: "Restricts the sources from which scripts, styles, images, and frames can be loaded.",
    why: "Blocks Cross-Site Scripting (XSS), data injection, and malicious external script execution.",
  },
  {
    name: "Strict-Transport-Security",
    short: "HSTS",
    importance: "Critical (Security)",
    desc: "Forces browsers to communicate exclusively over HTTPS for all present and future requests.",
    why: "Eliminates man-in-the-middle SSL stripping and protocol downgrade attacks.",
  },
  {
    name: "X-Content-Type-Options",
    short: "XCTO",
    importance: "High (Security)",
    desc: "Prevents the browser from MIME-sniffing a response away from the declared content-type.",
    why: "Stops malicious executable files disguised as benign images or text from executing.",
  },
  {
    name: "X-Frame-Options",
    short: "XFO",
    importance: "High (Security)",
    desc: "Controls whether the page can be rendered inside a <frame>, <iframe>, <embed> or <object>.",
    why: "Protects users against clickjacking attacks by forbidding illegitimate foreign iframe embedding.",
  },
  {
    name: "Referrer-Policy",
    short: "Referrer",
    importance: "Medium (Privacy)",
    desc: "Controls how much referrer information is sent along with navigation and subresource requests.",
    why: "Prevents sensitive query parameters, user tokens, and internal paths from leaking to third parties.",
  },
  {
    name: "Permissions-Policy",
    short: "Permissions",
    importance: "Medium (Security)",
    desc: "Explicitly grants or denies browser hardware and API permissions (camera, microphone, geolocation).",
    why: "Hardens user privacy by restricting unauthorized feature usage in embedded frames and third-party scripts.",
  },
  {
    name: "Cache-Control",
    short: "Cache",
    importance: "High (Performance)",
    desc: "Instructs browser and edge CDN caches how long responses may be cached and when to revalidate.",
    why: "Accelerates load times while ensuring dynamic or sensitive endpoints are not cached publicly.",
  },
  {
    name: "Server & Framework Masking",
    short: "Server",
    importance: "Informational (Hardening)",
    desc: "Removes or masks server banners (e.g. nginx/1.18.0, Express, Apache, PHP version).",
    why: "Denies attackers automated fingerprinting and version-specific vulnerability targeting.",
  },
];

const FAQS = [
  {
    q: "What are HTTP security response headers and why are they vital?",
    a: "HTTP security headers are directives sent by the web server in response to browser requests. They configure built-in browser security mechanisms to prevent critical vulnerabilities like Cross-Site Scripting (XSS), clickjacking, MIME-type confusion, and protocol downgrade attacks.",
  },
  {
    q: "What does a failing grade or low security score mean?",
    a: "A low score indicates that your server is not transmitting key defense-in-depth headers (like Content-Security-Policy or Strict-Transport-Security). While your website may still function normally, it is relying solely on application-level defenses without the browser-level containment policies recommended by OWASP.",
  },
  {
    q: "How does Content-Security-Policy (CSP) protect my users?",
    a: "CSP specifies trusted sources for executable scripts and media. Even if an attacker discovers a code injection flaw on your website, a strong CSP prevents the browser from executing foreign or untrusted inline scripts, neutralizing most XSS vectors.",
  },
  {
    q: "Why should I hide or mask the Server header?",
    a: "Exposing exact web server and framework version numbers (like Apache/2.4.41 or PHP/7.4) lets automated scanners quickly identify unpatched CVEs on your host. Masking or removing this header prevents easy automated reconnaissance.",
  },
];
---

<ToolLayout
  title="HeaderScan"
  subtitle="HTTP Security & Performance Header Analyzer"
  pill="SECURITY"
  toolSlug="headers"
  description="Analyze HTTP response headers for any web URL. Inspect security policies, cache directives, server configurations, and CSP."
>
  <div class={styles.headerScanContainer}>
    <!-- Scanner Card -->
    <section class={styles.scannerCard}>
      <form id="header-scan-form">
        <div class={styles.inputRow}>
          <div class={styles.inputWrapper}>
            <svg
              class={styles.inputIcon}
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input
              id="url-input"
              type="url"
              class={styles.urlInput}
              placeholder="https://example.com"
              value="https://iqverse.net"
              required
            />
          </div>
          <button type="submit" id="scan-submit-btn" class={styles.scanButton}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Scan Headers
          </button>
        </div>

        <div style="margin-top: 14px;">
          <CapCaptcha />
        </div>
      </form>

      <div class={styles.quickExamples}>
        <span class={styles.examplesLabel}>Try an example:</span>
        {
          QUICK_EXAMPLES.map((url) => (
            <button
              type="button"
              class={`${styles.exampleBtn} sample-btn`}
              data-url={url}
            >
              {url.replace("https://", "")}
            </button>
          ))
        }
      </div>
    </section>

    <!-- Loading State -->
    <div id="scan-loading" class={styles.statusBar} style="display: none;">
      <div
        style="display: inline-flex; align-items: center; justify-content: center; gap: 12px;"
      >
        <div class={styles.spinner}></div>
        <span
          id="loading-message"
          style="font-size: 0.95rem; font-weight: 500; font-family: var(--font-mono);"
        >
          Fetching HTTP response headers and analyzing security policies…
        </span>
      </div>
    </div>

    <!-- Error Box -->
    <div id="scan-error" class={styles.errorCard} style="display: none;">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--red)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="flex-shrink: 0; margin-top: 2px;"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <div id="scan-error-msg" class={styles.errorMessage}></div>
    </div>

    <!-- Scan Results Section -->
    <section
      id="scan-results-section"
      class={styles.resultsSection}
      style="display: none;"
    >
      <!-- Score Overview Card -->
      <!-- Score Overview Card -->
      <div class={styles.scorePanel}>
        <div>
          <div class={styles.scoreLabel}>Analyzed Target</div>
          <h2 id="target-url-display" class={styles.targetUrl}>--</h2>
          <div class={styles.badges}>
            <button
              type="button"
              class={`${styles.badge} ${styles.badgePass} header-stat-badge`}
              data-status="pass"
              style="cursor: pointer; font-family: inherit;"
            >
              <span id="count-passed">0</span> Passed
            </button>
            <button
              type="button"
              class={`${styles.badge} ${styles.badgeWarning} header-stat-badge`}
              data-status="warn"
              style="cursor: pointer; font-family: inherit;"
            >
              <span id="count-warnings">0</span> Warnings
            </button>
            <button
              type="button"
              class={`${styles.badge} ${styles.badgeFail} header-stat-badge`}
              data-status="fail"
              style="cursor: pointer; font-family: inherit;"
            >
              <span id="count-failed">0</span> Failed
            </button>
            <button
              type="button"
              class={`${styles.badge} ${styles.badgeInfo} header-stat-badge`}
              data-status="info"
              style="cursor: pointer; font-family: inherit;"
            >
              <span id="count-info-badge">0</span> Info
            </button>
          </div>
        </div>

        <div class={styles.scoreValueWrap}>
          <div class={styles.scoreLabel}>Security Score</div>
          <div id="score-number" class={styles.scoreValue}>0</div>
          <div>
            <span id="score-grade" class={styles.scoreGrade}>Grade A</span>
          </div>
          <div
            id="score-subtitle"
            class={styles.scoreSubtitle}
            style="margin-top: 4px;"
          >
            Security Posture
          </div>
        </div>
      </div>

      <!-- Navigation & Filter Toolbar (Category Tabs + Inline Search) -->
      <div
        class="tool-filter-bar"
        style="margin-top: 18px; margin-bottom: 12px;"
      >
        <div id="category-filter-buttons" class={styles.filterPills}>
          <button
            type="button"
            class={`${styles.filterPill} ${styles.activeFilter} header-tab-btn`}
            data-tab="all"
          >
            All Headers (<span id="count-all">0</span>)
          </button>
          <button
            type="button"
            class={`${styles.filterPill} header-tab-btn`}
            data-tab="security"
          >
            🛡️ Security (<span id="count-security">0</span>)
          </button>
          <button
            type="button"
            class={`${styles.filterPill} header-tab-btn`}
            data-tab="performance"
          >
            ⚡ Performance (<span id="count-performance">0</span>)
          </button>
          <button
            type="button"
            class={`${styles.filterPill} header-tab-btn`}
            data-tab="info"
          >
            ℹ️ Server & Info (<span id="count-info">0</span>)
          </button>
          <button
            type="button"
            class={`${styles.filterPill} header-tab-btn`}
            data-tab="raw"
          >
            📜 Raw Headers (<span id="count-raw">0</span>)
          </button>
        </div>

        <div class="search-input-wrap" style="max-width: 340px;">
          <svg
            class="search-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="header-search-input"
            type="text"
            class="tool-search-input"
            placeholder="Search headers, values, directives..."
          />
          <button
            type="button"
            id="btn-clear-header-search"
            class="search-clear-btn"
            title="Clear search">✕</button
          >
        </div>
      </div>

      <!-- Counter -->
      <div id="header-counter-bar" class="table-results-counter">
        <span
          >Showing <strong id="header-visible-count">0</strong> of <span
            id="header-total-count">0</span
          > checks</span
        >
      </div>

      <!-- Tab Content - Assessments Grid -->
      <div id="checks-grid" class={styles.checksGrid}></div>

      <!-- Empty State -->
      <div
        id="header-empty-state"
        class="tool-empty-state"
        style="display: none;"
      >
        <div class="tool-empty-state-icon">🔍</div>
        <div class="tool-empty-state-title">No matching headers found</div>
        <div class="tool-empty-state-text">
          Try adjusting your search query or switching the category/status
          filter.
        </div>
        <button
          type="button"
          id="btn-reset-header-filters"
          class="tool-empty-state-btn">Reset Filters</button
        >
      </div>

      <!-- Tab Content - Raw Headers Output -->
      <div
        id="raw-headers-pane"
        class={styles.rawHeaderCard}
        style="display: none;"
      >
        <div class={styles.rawHeaderHeader}>
          <h3 class={styles.rawHeaderTitle}>Raw HTTP Response Headers</h3>
          <button type="button" id="btn-copy-raw" class={styles.copyButton}>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path>
            </svg>
            <span id="copy-btn-text">Copy Headers</span>
          </button>
        </div>
        <pre id="raw-headers-output" class={styles.rawOutput}></pre>
      </div>
    </section>

    <!-- Methodology & Security Layers -->
    <section class={styles.infoSection}>
      <div class={styles.sectionHeader}>
        <span class={styles.sectionBadge}>Methodology</span>
        <h2 class={styles.sectionTitle}>
          Defense-in-Depth HTTP Security Architecture
        </h2>
        <p class={styles.sectionSub}>
          Security headers instruct modern browsers to enforce strict behavioral
          sandboxes, cutting off major exploitation vectors at the protocol
          layer.
        </p>
      </div>

      <div class={styles.stepsGrid}>
        <div class={styles.stepCard}>
          <span class={styles.stepNumber}>Layer 01</span>
          <h3 class={styles.stepTitle}>Transport & Encryption</h3>
          <p class={styles.stepText}>
            <code>HSTS</code> forces encrypted TLS connections and prevents SSL stripping
            attacks, securing data in transit across all subdomains.
          </p>
        </div>
        <div class={styles.stepCard}>
          <span class={styles.stepNumber}>Layer 02</span>
          <h3 class={styles.stepTitle}>Execution Sandboxing</h3>
          <p class={styles.stepText}>
            <code>CSP</code> and <code>X-Content-Type-Options</code> prevent unauthorized
            code execution, neutralizing Cross-Site Scripting (XSS) and MIME confusion.
          </p>
        </div>
        <div class={styles.stepCard}>
          <span class={styles.stepNumber}>Layer 03</span>
          <h3 class={styles.stepTitle}>Framing & Leak Prevention</h3>
          <p class={styles.stepText}>
            <code>X-Frame-Options</code>, <code>Referrer-Policy</code>, and <code
              >Permissions-Policy</code
            > block clickjacking and prevent accidental token leakage.
          </p>
        </div>
      </div>
    </section>

    <!-- Scoring Bands -->
    <section class={styles.infoSection}>
      <div class={styles.sectionHeader}>
        <span class={styles.sectionBadge}>Grading</span>
        <h2 class={styles.sectionTitle}>Security Score & Grade Bands</h2>
        <p class={styles.sectionSub}>
          Scores are computed from OWASP-recommended HTTP header checks and
          security configurations.
        </p>
      </div>

      <div class={styles.bandsGrid}>
        <div class={`${styles.bandCard} ${styles.bandStrong}`}>
          <div class={styles.bandHeader}>
            <span class={styles.bandScore}>90 – 100</span>
            <span class={styles.bandBadge}>Grade A+</span>
          </div>
          <p class={styles.bandReading}>
            Outstanding defense posture. Complete security policies configured
            without unsafe directives.
          </p>
        </div>
        <div class={`${styles.bandCard} ${styles.bandGood}`}>
          <div class={styles.bandHeader}>
            <span class={styles.bandScore}>80 – 89</span>
            <span class={styles.bandBadge}>Grade A</span>
          </div>
          <p class={styles.bandReading}>
            Robust protection. Core security headers present with minor
            configuration recommendations.
          </p>
        </div>
        <div class={`${styles.bandCard} ${styles.bandNeedsWork}`}>
          <div class={styles.bandHeader}>
            <span class={styles.bandScore}>60 – 79</span>
            <span class={styles.bandBadge}>Grade B / C</span>
          </div>
          <p class={styles.bandReading}>
            Partial coverage. Critical headers like CSP or HSTS are missing or
            weakly configured.
          </p>
        </div>
        <div class={`${styles.bandCard} ${styles.bandAtRisk}`}>
          <div class={styles.bandHeader}>
            <span class={styles.bandScore}>0 – 59</span>
            <span class={styles.bandBadge}>Grade D / F</span>
          </div>
          <p class={styles.bandReading}>
            Vulnerable posture. Lacks basic browser-enforced security headers
            and protections.
          </p>
        </div>
      </div>
    </section>

    <!-- Headers Reference Guide -->
    <section class={styles.infoSection}>
      <div class={styles.sectionHeader}>
        <span class={styles.sectionBadge}>Reference</span>
        <h2 class={styles.sectionTitle}>Key HTTP Headers Reference Guide</h2>
      </div>

      <div class={styles.guideCardsGrid}>
        {
          HEADERS_GUIDE.map((h) => (
            <div class={styles.guideDetailCard}>
              <div class={styles.guideHeader}>
                <h3 class={styles.guideName}>{h.name}</h3>
                <span class={styles.guideBadge}>{h.short}</span>
              </div>
              <p class={styles.guideBlock}>{h.desc}</p>
              <p class={styles.guideBlock} style="margin-top: 4px;">
                <strong>Why it matters:</strong> {h.why}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FAQ Section -->
    <section class={styles.infoSection}>
      <div class={styles.sectionHeader}>
        <span class={styles.sectionBadge}>FAQ</span>
        <h2 class={styles.sectionTitle}>Frequently Asked Questions</h2>
      </div>

      <div class={styles.faqList}>
        {
          FAQS.map((faq) => (
            <details class={styles.faqCard}>
              <summary
                class={styles.faqQuestionRow}
                style="list-style: none; cursor: pointer;"
              >
                <h3 class={styles.faqQuestion}>{faq.q}</h3>
                <span class={styles.faqIcon}>+</span>
              </summary>
              <p class={styles.faqAnswer}>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import {
    analyzeHeaders,
    type HeaderAssessment,
    type HeaderAnalysisResult,
  } from "@/lib/headers";
  import { validateCaptcha } from "@/lib/captcha";
  import { escapeHtml } from "@/lib/utils";

  const form = document.getElementById("header-scan-form") as HTMLFormElement;
  const urlInput = document.getElementById("url-input") as HTMLInputElement;
  const sampleBtns = document.querySelectorAll(".sample-btn");

  const loadingBox = document.getElementById("scan-loading");
  const errorBox = document.getElementById("scan-error");
  const errorMsg = document.getElementById("scan-error-msg");
  const resultsSection = document.getElementById("scan-results-section");
  const targetUrlEl = document.getElementById("target-url-display");
  const scoreNum = document.getElementById("score-number");
  const scoreGrade = document.getElementById("score-grade");
  const scoreSubtitle = document.getElementById("score-subtitle");
  const countPassed = document.getElementById("count-passed");
  const countWarnings = document.getElementById("count-warnings");
  const countFailed = document.getElementById("count-failed");
  const countInfoBadge = document.getElementById("count-info-badge");

  const countAll = document.getElementById("count-all");
  const countSec = document.getElementById("count-security");
  const countPerf = document.getElementById("count-performance");
  const countInfo = document.getElementById("count-info");
  const countRaw = document.getElementById("count-raw");

  const pillPass = document.getElementById("pill-count-pass");
  const pillWarn = document.getElementById("pill-count-warn");
  const pillFail = document.getElementById("pill-count-fail");

  const filterToolbar = document.getElementById("header-filter-toolbar");
  const counterBar = document.getElementById("header-counter-bar");
  const headerVisibleCount = document.getElementById("header-visible-count");
  const headerTotalCount = document.getElementById("header-total-count");
  const headerEmptyState = document.getElementById("header-empty-state");
  const headerSearchInput = document.getElementById(
    "header-search-input",
  ) as HTMLInputElement;
  const btnClearHeaderSearch = document.getElementById(
    "btn-clear-header-search",
  );
  const btnResetHeaderFilters = document.getElementById(
    "btn-reset-header-filters",
  );
  const headerStatBadges = document.querySelectorAll(".header-stat-badge");

  const checksGrid = document.getElementById("checks-grid");
  const rawHeadersPane = document.getElementById("raw-headers-pane");
  const rawHeadersOut = document.getElementById("raw-headers-output");
  const tabBtns = document.querySelectorAll(".header-tab-btn");
  const btnCopyRaw = document.getElementById("btn-copy-raw");
  const copyBtnText = document.getElementById("copy-btn-text");

  let currentTab = "all";
  let currentStatus = "all";
  let latestResult: HeaderAnalysisResult | null = null;

  sampleBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (urlInput) {
        urlInput.value = (btn as HTMLElement).dataset.url || "";
        const { valid } = validateCaptcha(form);
        if (valid) {
          form?.dispatchEvent(new Event("submit"));
        }
      }
    });
  });

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      tabBtns.forEach((b) => {
        b.classList.remove("active");
        b.removeAttribute("data-active");
      });
      btn.classList.add("active");
      btn.setAttribute("data-active", "true");
      currentTab = (btn as HTMLElement).dataset.tab || "all";
      renderView();
    });
  });

  headerStatBadges.forEach((badge) => {
    badge.addEventListener("click", () => {
      const clickedStatus = (badge as HTMLElement).dataset.status || "all";
      if (currentStatus === clickedStatus) {
        currentStatus = "all";
        headerStatBadges.forEach(
          (b) => ((b as HTMLElement).style.opacity = "1"),
        );
      } else {
        currentStatus = clickedStatus;
        headerStatBadges.forEach((b) => {
          if ((b as HTMLElement).dataset.status === clickedStatus) {
            (b as HTMLElement).style.opacity = "1";
            (b as HTMLElement).style.boxShadow = "0 0 0 2px var(--accent)";
          } else {
            (b as HTMLElement).style.opacity = "0.55";
            (b as HTMLElement).style.boxShadow = "none";
          }
        });
      }
      renderView();
    });
  });

  headerSearchInput?.addEventListener("input", () => {
    if (btnClearHeaderSearch) {
      btnClearHeaderSearch.style.display = headerSearchInput.value
        ? "inline-block"
        : "none";
    }
    renderView();
  });

  btnClearHeaderSearch?.addEventListener("click", () => {
    if (headerSearchInput) {
      headerSearchInput.value = "";
      btnClearHeaderSearch.style.display = "none";
      renderView();
      headerSearchInput.focus();
    }
  });

  btnResetHeaderFilters?.addEventListener("click", () => {
    currentStatus = "all";
    headerStatBadges.forEach((b) => {
      (b as HTMLElement).style.opacity = "1";
      (b as HTMLElement).style.boxShadow = "none";
    });
    if (headerSearchInput) {
      headerSearchInput.value = "";
      if (btnClearHeaderSearch) btnClearHeaderSearch.style.display = "none";
    }
    renderView();
  });

  btnCopyRaw?.addEventListener("click", async () => {
    if (!rawHeadersOut?.textContent) return;
    try {
      await navigator.clipboard.writeText(rawHeadersOut.textContent);
      if (copyBtnText) copyBtnText.textContent = "✓ Copied!";
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = "Copy Headers";
      }, 2000);
    } catch {
      // Fallback
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const raw = urlInput?.value.trim();
    if (!raw) return;

    const { valid, token } = validateCaptcha(form);
    if (!valid) return;

    const normalized =
      raw.startsWith("http://") || raw.startsWith("https://")
        ? raw
        : `https://${raw}`;

    if (loadingBox) loadingBox.style.display = "block";
    if (errorBox) errorBox.style.display = "none";
    if (resultsSection) resultsSection.style.display = "none";

    try {
      const result = await analyzeHeaders(normalized, token || undefined);
      latestResult = result;

      if (targetUrlEl) targetUrlEl.textContent = result.url;
      if (scoreNum) {
        scoreNum.textContent = String(result.score);
        scoreNum.style.color =
          result.score >= 80
            ? "var(--green)"
            : result.score >= 50
              ? "var(--yellow)"
              : "var(--red)";
      }

      if (scoreGrade) {
        scoreGrade.textContent = `Grade ${result.grade}`;
        scoreGrade.style.color =
          result.score >= 80
            ? "var(--green)"
            : result.score >= 50
              ? "var(--yellow)"
              : "var(--red)";
        scoreGrade.style.background =
          result.score >= 80
            ? "rgba(52, 211, 153, 0.15)"
            : result.score >= 50
              ? "rgba(251, 191, 36, 0.15)"
              : "rgba(248, 113, 113, 0.15)";
      }

      if (scoreSubtitle) {
        scoreSubtitle.textContent =
          result.score >= 80
            ? "Strong Security Posture"
            : result.score >= 50
              ? "Partial Protection"
              : "At Risk - Needs Hardening";
      }

      // Count assessments
      const pCount = result.assessments.filter(
        (a) => a.status === "pass",
      ).length;
      const wCount = result.assessments.filter(
        (a) => a.status === "warn",
      ).length;
      const fCount = result.assessments.filter(
        (a) => a.status === "fail",
      ).length;
      const iCount = result.assessments.filter(
        (a) => a.status === "info",
      ).length;

      if (countPassed) countPassed.textContent = String(pCount);
      if (countWarnings) countWarnings.textContent = String(wCount);
      if (countFailed) countFailed.textContent = String(fCount);
      if (countInfoBadge) countInfoBadge.textContent = String(iCount);

      if (pillPass) pillPass.textContent = String(pCount);
      if (pillWarn) pillWarn.textContent = String(wCount);
      if (pillFail) pillFail.textContent = String(fCount);

      // Category counts
      const secItems = result.assessments.filter(
        (a) => a.category === "security",
      );
      const perfItems = result.assessments.filter(
        (a) => a.category === "performance",
      );
      const infoItems = result.assessments.filter((a) => a.category === "info");

      if (countAll) countAll.textContent = String(result.assessments.length);
      if (countSec) countSec.textContent = String(secItems.length);
      if (countPerf) countPerf.textContent = String(perfItems.length);
      if (countInfo) countInfo.textContent = String(infoItems.length);
      if (countRaw)
        countRaw.textContent = String(Object.keys(result.rawHeaders).length);

      if (rawHeadersOut) {
        const sortedEntries = Object.entries(result.rawHeaders).sort(
          ([a], [b]) => a.localeCompare(b),
        );
        rawHeadersOut.textContent = sortedEntries
          .map(([k, v]) => `${k}: ${v}`)
          .join("\n");
      }

      renderView();
      if (resultsSection) resultsSection.style.display = "flex";
    } catch (err: any) {
      if (errorBox && errorMsg) {
        errorBox.style.display = "flex";
        errorMsg.textContent =
          err.message || "Failed to analyze headers for the target URL.";
      }
    } finally {
      if (loadingBox) loadingBox.style.display = "none";
    }
  });

  function renderView() {
    if (!latestResult) return;

    if (currentTab === "raw") {
      if (checksGrid) checksGrid.style.display = "none";
      if (filterToolbar) filterToolbar.style.display = "none";
      if (counterBar) counterBar.style.display = "none";
      if (headerEmptyState) headerEmptyState.style.display = "none";
      if (rawHeadersPane) rawHeadersPane.style.display = "flex";
      return;
    }

    if (rawHeadersPane) rawHeadersPane.style.display = "none";
    if (filterToolbar) filterToolbar.style.display = "flex";
    if (counterBar) counterBar.style.display = "flex";

    const query = (headerSearchInput?.value || "").toLowerCase().trim();

    const categoryFiltered = latestResult.assessments.filter((a) => {
      if (currentTab === "all") return true;
      return a.category === currentTab;
    });

    const filtered = categoryFiltered.filter((a) => {
      if (currentStatus !== "all" && a.status !== currentStatus) return false;
      if (query) {
        const matchesName = a.name.toLowerCase().includes(query);
        const matchesShort = (a.short || "").toLowerCase().includes(query);
        const matchesDesc = a.description.toLowerCase().includes(query);
        const matchesMsg = a.message.toLowerCase().includes(query);
        const matchesRec = (a.recommendation || "")
          .toLowerCase()
          .includes(query);
        if (
          !matchesName &&
          !matchesShort &&
          !matchesDesc &&
          !matchesMsg &&
          !matchesRec
        ) {
          return false;
        }
      }
      return true;
    });

    if (headerVisibleCount)
      headerVisibleCount.textContent = String(filtered.length);
    if (headerTotalCount)
      headerTotalCount.textContent = String(categoryFiltered.length);

    if (filtered.length === 0) {
      if (checksGrid) checksGrid.style.display = "none";
      if (headerEmptyState) headerEmptyState.style.display = "flex";
      return;
    }

    if (headerEmptyState) headerEmptyState.style.display = "none";
    if (checksGrid) checksGrid.style.display = "grid";

    if (checksGrid) {
      checksGrid.innerHTML = filtered
        .map((item: HeaderAssessment) => {
          const statusClass =
            item.status === "pass"
              ? "header-check-card-pass"
              : item.status === "warn"
                ? "header-check-card-warn"
                : item.status === "fail"
                  ? "header-check-card-fail"
                  : "header-check-card-info";

          const statusPillClass =
            item.status === "pass"
              ? "header-status-pill-pass"
              : item.status === "warn"
                ? "header-status-pill-warn"
                : item.status === "fail"
                  ? "header-status-pill-fail"
                  : "header-status-pill-info";

          const statusIcon =
            item.status === "pass"
              ? "✓"
              : item.status === "warn"
                ? "⚠️"
                : item.status === "fail"
                  ? "✕"
                  : "ℹ";

          return `
          <div class="header-check-card ${statusClass}">
            <div class="header-check-head">
              <div class="header-check-title-wrap">
                <h3 class="header-check-name">${escapeHtml(item.name)}</h3>
                ${item.short ? `<span class="header-short-badge">${escapeHtml(item.short)}</span>` : ""}
                <span class="header-category-badge">${escapeHtml(item.category)}</span>
              </div>
              <div class="header-check-meta-badges">
                <span class="header-status-pill ${statusPillClass}">${escapeHtml(item.status)}</span>
              </div>
            </div>
            <p class="header-check-desc">${escapeHtml(item.description)}</p>
            <div class="header-check-result-box">
              <span>${statusIcon}</span>
              <span><strong>Result:</strong> ${escapeHtml(item.message)}</span>
            </div>
            ${
              item.recommendation && item.status !== "pass"
                ? `<div class="header-rec-box">
                    <span class="header-rec-highlight">💡 Recommendation:</span>
                    <span>${escapeHtml(item.recommendation)}</span>
                  </div>`
                : ""
            }
          </div>
        `;
        })
        .join("");
    }
  }
</script>
