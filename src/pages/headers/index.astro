---
import ToolLayout from '@/layouts/ToolLayout.astro';
import styles from '@/styles/header-scan.module.css';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const SAMPLE_URLS = ['https://example.com', 'https://github.com', 'https://google.com'];
---

<ToolLayout
  title="HeaderScan"
  subtitle="HTTP Security & Performance Header Analyzer"
  pill="SECURITY"
  toolSlug="headers"
  description="Analyze HTTP response headers for any web URL. Inspect security policies, cache directives, server configurations, and CSP."
>
  <div style="max-width: 1100px;">
    <section class={styles.heroSection}>
      <form id="header-scan-form" class={styles.form}>
        <div class={styles.inputGroup}>
          <input
            id="url-input"
            type="url"
            class={styles.urlInput}
            placeholder="https://example.com"
            value="https://example.com"
            required
          />
          <button type="submit" id="scan-submit-btn" class={styles.scanButton}>
            Scan Headers
          </button>
        </div>
      </form>

      <div class={styles.samples}>
        <span>Try:</span>
        {SAMPLE_URLS.map((u) => (
          <button type="button" class="sample-btn" data-url={u}>
            {u}
          </button>
        ))}
      </div>
    </section>

    <div id="scan-loading" class={styles.loadingBox} style="display: none;">
      <div class={styles.spinner}></div>
      <p>Analyzing HTTP response headers...</p>
    </div>

    <div id="scan-error" class={sharedStyles.errorCard} style="margin-top: 20px; display: none;">
      <div id="scan-error-msg" class={sharedStyles.errorMessage}></div>
    </div>

    <section id="scan-results-section" style="display: none; margin-top: 24px;">
      <!-- Score Overview -->
      <div class={styles.scoreCard}>
        <div class={styles.scoreRow}>
          <div>
            <span class={styles.scoreMeta}>Target URL</span>
            <h3 id="target-url-display" class={styles.targetUrl}></h3>
          </div>
          <div class={styles.scoreBadgeWrap}>
            <span class={styles.scoreMeta}>Security Score</span>
            <div id="score-badge" class={styles.scoreBadge}>--</div>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class={styles.tabs}>
        <button type="button" class={`${styles.tabBtn} ${styles.tabBtnActive}`} data-tab="security">
          Security (<span id="count-security">0</span>)
        </button>
        <button type="button" class={styles.tabBtn} data-tab="performance">
          Performance (<span id="count-performance">0</span>)
        </button>
        <button type="button" class={styles.tabBtn} data-tab="info">
          Info (<span id="count-info">0</span>)
        </button>
        <button type="button" class={styles.tabBtn} data-tab="raw">
          Raw Headers (<span id="count-raw">0</span>)
        </button>
      </div>

      <!-- Tab Contents -->
      <div id="tab-content-security" class="tab-pane"></div>
      <div id="tab-content-performance" class="tab-pane" style="display: none;"></div>
      <div id="tab-content-info" class="tab-pane" style="display: none;"></div>
      <div id="tab-content-raw" class="tab-pane" style="display: none;">
        <div class={sharedStyles.card}>
          <pre id="raw-headers-output" style="max-height: 400px; overflow: auto; font-family: monospace;"></pre>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  type Status = 'pass' | 'warn' | 'fail' | 'info';
  type AssessmentCategory = 'security' | 'performance' | 'info';

  const HEADER_DEFINITIONS = [
    {
      name: 'Content-Security-Policy',
      short: 'CSP',
      category: 'security' as AssessmentCategory,
      description: 'Controls which resources the browser may load.',
      recommendation: "Add: Content-Security-Policy: default-src 'self'; script-src 'self';",
      check: (val: string) => {
        if (!val) return { status: 'fail' as Status, message: 'CSP is missing.' };
        if (/unsafe-inline/i.test(val)) return { status: 'warn' as Status, message: "'unsafe-inline' weakens CSP." };
        return { status: 'pass' as Status, message: 'CSP is configured.' };
      },
    },
    {
      name: 'Strict-Transport-Security',
      short: 'HSTS',
      category: 'security' as AssessmentCategory,
      description: 'Forces HTTPS for all future requests.',
      recommendation: 'Add: Strict-Transport-Security: max-age=31536000; includeSubDomains; preload',
      check: (val: string) => {
        if (!val) return { status: 'fail' as Status, message: 'HSTS is not configured.' };
        return { status: 'pass' as Status, message: 'HSTS is configured.' };
      },
    },
    {
      name: 'X-Content-Type-Options',
      short: 'XCTO',
      category: 'security' as AssessmentCategory,
      description: 'Prevents MIME-sniffing.',
      recommendation: 'Add: X-Content-Type-Options: nosniff',
      check: (val: string) => {
        if (!val) return { status: 'fail' as Status, message: 'Missing header.' };
        return { status: 'pass' as Status, message: 'Correctly set to nosniff.' };
      },
    },
    {
      name: 'X-Frame-Options',
      short: 'XFO',
      category: 'security' as AssessmentCategory,
      description: 'Prevents clickjacking.',
      recommendation: 'Add: X-Frame-Options: DENY',
      check: (val: string) => {
        if (!val) return { status: 'warn' as Status, message: 'Consider setting DENY or SAMEORIGIN.' };
        return { status: 'pass' as Status, message: 'Clickjacking protection configured.' };
      },
    },
    {
      name: 'Cache-Control',
      short: 'Cache',
      category: 'performance' as AssessmentCategory,
      description: 'Defines caching behavior.',
      recommendation: 'Add: Cache-Control with appropriate max-age directives',
      check: (val: string) => {
        if (!val) return { status: 'warn' as Status, message: 'No Cache-Control header found.' };
        return { status: 'pass' as Status, message: `Configured: ${val}` };
      },
    },
    {
      name: 'Server',
      short: 'Server',
      category: 'info' as AssessmentCategory,
      description: 'Identifies web server software.',
      recommendation: 'Mask detailed version numbers to avoid information disclosure.',
      check: (val: string) => {
        if (!val) return { status: 'pass' as Status, message: 'Server header is hidden.' };
        return { status: 'info' as Status, message: `Server: ${val}` };
      },
    },
  ];

  const form = document.getElementById('header-scan-form') as HTMLFormElement;
  const urlInput = document.getElementById('url-input') as HTMLInputElement;
  const sampleBtns = document.querySelectorAll('.sample-btn');
  const loadingBox = document.getElementById('scan-loading');
  const errorBox = document.getElementById('scan-error');
  const errorMsg = document.getElementById('scan-error-msg');
  const resultsSection = document.getElementById('scan-results-section');
  const targetUrlEl = document.getElementById('target-url-display');
  const scoreBadge = document.getElementById('score-badge');
  const rawHeadersOut = document.getElementById('raw-headers-output');
  const tabBtns = document.querySelectorAll(`.${styles.tabBtn}`);

  let activeTab = 'security';

  sampleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (urlInput) {
        urlInput.value = (btn as HTMLElement).dataset.url || '';
        form?.dispatchEvent(new Event('submit'));
      }
    });
  });

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach((b) => b.classList.remove(styles.tabBtnActive));
      btn.classList.add(styles.tabBtnActive);
      activeTab = (btn as HTMLElement).dataset.tab || 'security';

      document.querySelectorAll('.tab-pane').forEach((pane) => {
        (pane as HTMLElement).style.display = 'none';
      });
      const currentPane = document.getElementById(`tab-content-${activeTab}`);
      if (currentPane) currentPane.style.display = 'block';
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = urlInput?.value.trim();
    if (!url) return;

    if (loadingBox) loadingBox.style.display = 'block';
    if (errorBox) errorBox.style.display = 'none';
    if (resultsSection) resultsSection.style.display = 'none';

    try {
      const res = await fetch(`/api/check-url?url=${encodeURIComponent(url)}`);
      if (!res.ok) throw new Error(`HTTP Error ${res.status}`);
      const data = await res.json();

      if (data.error) throw new Error(data.error);

      const headers: Record<string, string> = data.headers || {};

      let passCount = 0;
      let totalSecurity = 0;

      const assessments = HEADER_DEFINITIONS.map((def) => {
        const val = headers[def.name.toLowerCase()] || '';
        const chk = def.check(val);
        if (def.category === 'security') {
          totalSecurity++;
          if (chk.status === 'pass') passCount += 1;
          else if (chk.status === 'warn') passCount += 0.5;
        }
        return {
          ...def,
          value: val,
          status: chk.status,
          message: chk.message,
        };
      });

      const score = Math.round((passCount / (totalSecurity || 1)) * 100);

      if (targetUrlEl) targetUrlEl.textContent = url;
      if (scoreBadge) {
        scoreBadge.textContent = `${score}/100`;
        scoreBadge.style.color = score >= 80 ? '#4caf50' : score >= 50 ? '#faad14' : '#ff4d4f';
      }

      // Render cards into tabs
      ['security', 'performance', 'info'].forEach((cat) => {
        const pane = document.getElementById(`tab-content-${cat}`);
        const items = assessments.filter((a) => a.category === cat);
        const countBadge = document.getElementById(`count-${cat}`);
        if (countBadge) countBadge.textContent = String(items.length);

        if (pane) {
          pane.innerHTML = items
            .map(
              (item) => `
            <div style="padding: 16px; border-radius: 8px; background: var(--card); border: 1px solid var(--border); margin-bottom: 12px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <strong style="font-family: monospace; font-size: 1rem;">${item.name}</strong>
                <span style="padding: 2px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; background: ${
                  item.status === 'pass'
                    ? 'rgba(76, 175, 80, 0.2)'
                    : item.status === 'warn'
                    ? 'rgba(250, 173, 20, 0.2)'
                    : item.status === 'fail'
                    ? 'rgba(255, 77, 79, 0.2)'
                    : 'rgba(33, 150, 243, 0.2)'
                }; color: ${
                item.status === 'pass'
                  ? '#4caf50'
                  : item.status === 'warn'
                  ? '#faad14'
                  : item.status === 'fail'
                  ? '#ff4d4f'
                  : '#2196f3'
              };">${item.status}</span>
              </div>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 6px;">${item.description}</p>
              <div style="font-size: 0.85rem; margin-bottom: 4px;"><strong>Finding:</strong> ${item.message}</div>
              ${item.value ? `<div style="font-family: monospace; font-size: 0.8rem; background: rgba(0,0,0,0.2); padding: 6px; border-radius: 4px; word-break: break-all;">${item.value}</div>` : ''}
            </div>
          `
            )
            .join('');
        }
      });

      // Raw headers
      const rawCount = document.getElementById('count-raw');
      if (rawCount) rawCount.textContent = String(Object.keys(headers).length);
      if (rawHeadersOut) {
        rawHeadersOut.textContent = Object.entries(headers)
          .map(([k, v]) => `${k}: ${v}`)
          .join('\n');
      }

      if (resultsSection) resultsSection.style.display = 'block';
    } catch (err: any) {
      if (errorBox && errorMsg) {
        errorBox.style.display = 'block';
        errorMsg.textContent = err.message || 'Failed to scan headers.';
      }
    } finally {
      if (loadingBox) loadingBox.style.display = 'none';
    }
  });
</script>
