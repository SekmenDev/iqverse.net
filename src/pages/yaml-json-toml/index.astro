---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const DEFAULT_JSON = `{\n  "title": "IQVerse Config",\n  "version": 1,\n  "enabled": true,\n  "tags": ["developer", "tools", "ai"]\n}`;
---

<ToolLayout
  title="YAML / JSON / TOML Converter"
  subtitle="Bidirectional Config Format Converter"
  pill="BROWSER TOOLS"
  toolSlug="yaml-json-toml"
  description="Convert between JSON, YAML, and TOML data formats instantly with client-side syntax parsing."
>
  <div style="max-width: 1000px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 16px; flex-wrap: wrap;">
          <div class={sharedStyles.buttonGroup} style="margin: 0;">
            <label for="srcFmt">Source Format:</label>
            <select id="srcFmt" style="margin-left: 8px;">
              <option value="json">JSON</option>
              <option value="yaml">YAML</option>
            </select>
          </div>

          <div style="font-size: 1.2rem;">➔</div>

          <div class={sharedStyles.buttonGroup} style="margin: 0;">
            <label for="tgtFmt">Target Format:</label>
            <select id="tgtFmt" style="margin-left: 8px;">
              <option value="yaml">YAML</option>
              <option value="json">JSON</option>
              <option value="toml">TOML</option>
            </select>
          </div>

          <button
            type="button"
            id="btn-convert-fmt"
            class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
          >
            Convert Format
          </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="fmtInput">
              Source Data (<span id="src-label">JSON</span>)
            </label>
            <textarea
              id="fmtInput"
              class={sharedStyles.textarea}
              rows="12"
              style="font-family: monospace;"
            >{DEFAULT_JSON}</textarea>
          </div>

          <div class={sharedStyles.field}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <label class={sharedStyles.fieldLabel} for="fmtOutput">
                Converted Output (<span id="tgt-label">YAML</span>)
              </label>
              <button type="button" id="btn-copy-converted" class={sharedStyles.button}>
                Copy Result
              </button>
            </div>
            <textarea
              id="fmtOutput"
              readonly
              class={sharedStyles.outputArea}
              rows="12"
              style="font-family: monospace;"
            ></textarea>
          </div>
        </div>

        <div id="fmt-error-card" class={sharedStyles.errorCard} style="margin-top: 16px; display: none;">
          <div id="fmt-error-msg" class={sharedStyles.errorMessage}></div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  function objectToYaml(obj: unknown, indentLevel = 0): string {
    const indent = '  '.repeat(indentLevel);
    if (obj === null) return 'null';
    if (typeof obj === 'boolean') return obj ? 'true' : 'false';
    if (typeof obj === 'number') return obj.toString();
    if (typeof obj === 'string') {
      if (obj.includes('\n') || obj.includes(':') || obj.includes('#')) {
        return `"${obj.replace(/"/g, '\\"')}"`;
      }
      return obj || '""';
    }

    if (Array.isArray(obj)) {
      if (obj.length === 0) return '[]';
      return obj
        .map((item) => {
          if (typeof item === 'object' && item !== null) {
            const subYaml = objectToYaml(item, indentLevel + 1).trimStart();
            return `${indent}- ${subYaml}`;
          }
          return `${indent}- ${objectToYaml(item, indentLevel)}`;
        })
        .join('\n');
    }

    if (typeof obj === 'object') {
      const keys = Object.keys(obj as Record<string, unknown>);
      if (keys.length === 0) return '{}';
      return keys
        .map((key) => {
          const val = (obj as Record<string, unknown>)[key];
          if (typeof val === 'object' && val !== null && !Array.isArray(val)) {
            return `${indent}${key}:\n${objectToYaml(val, indentLevel + 1)}`;
          }
          if (Array.isArray(val)) {
            return `${indent}${key}:\n${objectToYaml(val, indentLevel + 1)}`;
          }
          return `${indent}${key}: ${objectToYaml(val, indentLevel)}`;
        })
        .join('\n');
    }

    return String(obj);
  }

  function yamlToObject(yamlStr: string): unknown {
    const lines = yamlStr.split('\n').filter((l) => l.trim() && !l.trim().startsWith('#'));
    const root: Record<string, unknown> = {};

    lines.forEach((line) => {
      const trimmed = line.trim();
      const colonIdx = trimmed.indexOf(':');
      if (colonIdx > 0) {
        const key = trimmed.slice(0, colonIdx).trim();
        let valStr = trimmed.slice(colonIdx + 1).trim();
        if (valStr.startsWith('"') && valStr.endsWith('"')) {
          valStr = valStr.slice(1, -1);
        }
        let val: unknown = valStr;
        if (valStr === 'true') val = true;
        else if (valStr === 'false') val = false;
        else if (valStr === 'null') val = null;
        else if (!isNaN(Number(valStr)) && valStr !== '') val = Number(valStr);

        root[key] = val;
      }
    });

    return Object.keys(root).length > 0 ? root : JSON.parse(yamlStr);
  }

  function objectToToml(obj: Record<string, unknown>): string {
    let toml = '';
    const primitives: string[] = [];
    const tables: string[] = [];

    Object.entries(obj).forEach(([key, val]) => {
      if (typeof val === 'object' && val !== null && !Array.isArray(val)) {
        tables.push(`[${key}]\n${objectToToml(val as Record<string, unknown>)}`);
      } else if (typeof val === 'string') {
        primitives.push(`${key} = "${val}"`);
      } else if (typeof val === 'boolean' || typeof val === 'number') {
        primitives.push(`${key} = ${val}`);
      } else if (Array.isArray(val)) {
        primitives.push(`${key} = ${JSON.stringify(val)}`);
      }
    });

    toml = primitives.join('\n');
    if (tables.length > 0) {
      if (toml) toml += '\n\n';
      toml += tables.join('\n\n');
    }

    return toml;
  }

  const srcFmt = document.getElementById('srcFmt') as HTMLSelectElement;
  const tgtFmt = document.getElementById('tgtFmt') as HTMLSelectElement;
  const srcLabel = document.getElementById('src-label');
  const tgtLabel = document.getElementById('tgt-label');
  const fmtInput = document.getElementById('fmtInput') as HTMLTextAreaElement;
  const fmtOutput = document.getElementById('fmtOutput') as HTMLTextAreaElement;
  const btnConvert = document.getElementById('btn-convert-fmt');
  const btnCopy = document.getElementById('btn-copy-converted');
  const errorCard = document.getElementById('fmt-error-card');
  const errorMsg = document.getElementById('fmt-error-msg');

  srcFmt?.addEventListener('change', () => {
    if (srcLabel) srcLabel.textContent = srcFmt.value.toUpperCase();
  });
  tgtFmt?.addEventListener('change', () => {
    if (tgtLabel) tgtLabel.textContent = tgtFmt.value.toUpperCase();
  });

  function convert() {
    if (errorCard) errorCard.style.display = 'none';
    if (fmtOutput) fmtOutput.value = '';

    try {
      const source = srcFmt?.value || 'json';
      const target = tgtFmt?.value || 'yaml';
      const text = fmtInput?.value || '';

      let parsedObj: any = null;
      if (source === 'json') {
        parsedObj = JSON.parse(text);
      } else {
        parsedObj = yamlToObject(text);
      }

      let result = '';
      if (target === 'json') {
        result = JSON.stringify(parsedObj, null, 2);
      } else if (target === 'yaml') {
        result = objectToYaml(parsedObj);
      } else if (target === 'toml') {
        if (typeof parsedObj !== 'object' || parsedObj === null || Array.isArray(parsedObj)) {
          throw new TypeError('TOML root must be an object/table.');
        }
        result = objectToToml(parsedObj);
      }

      if (fmtOutput) fmtOutput.value = result;
    } catch (err: any) {
      if (errorCard && errorMsg) {
        errorCard.style.display = 'block';
        errorMsg.textContent = `Parsing Error: ${err.message || 'Invalid input syntax.'}`;
      }
    }
  }

  btnConvert?.addEventListener('click', convert);

  btnCopy?.addEventListener('click', async () => {
    if (fmtOutput?.value && btnCopy) {
      await navigator.clipboard.writeText(fmtOutput.value);
      const prev = btnCopy.textContent;
      btnCopy.textContent = 'Copied!';
      setTimeout(() => (btnCopy.textContent = prev), 1500);
    }
  });

  convert();
</script>
