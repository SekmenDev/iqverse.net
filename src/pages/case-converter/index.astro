---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';
---

<ToolLayout
  title="Text Case Converter"
  subtitle="Convert camelCase, PascalCase, snake_case, kebab-case & More"
  pill="BROWSER TOOLS"
  toolSlug="case-converter"
  description="Convert strings between camelCase, PascalCase, snake_case, kebab-case, CONSTANT_CASE, Title Case and alternating case."
>
  <div style="max-width: 1000px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div class={sharedStyles.field}>
          <label class={sharedStyles.fieldLabel} for="caseInput">
            Input Text
          </label>
          <textarea
            id="caseInput"
            class={sharedStyles.textarea}
            rows="4"
            placeholder="Type or paste text to convert..."
          >Hello world! IQVerse developer tools</textarea>
        </div>

        <div style="margin-top: 24px;">
          <h3 style="margin: 0 0 16px 0; font-size: 1.1rem;">Conversions</h3>
          <div id="conversions-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;"></div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { convertCases } from '@/lib/case-converter';

  const caseInput = document.getElementById('caseInput') as HTMLTextAreaElement;
  const grid = document.getElementById('conversions-grid');

  function renderConversions() {
    if (!caseInput || !grid) return;
    const list = convertCases(caseInput.value);

    grid.innerHTML = list
      .map(
        (item) => `
      <div
        style="padding: 14px; border-radius: 8px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border); display: flex; flex-direction: column; justify-content: space-between;"
      >
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <span style="font-size: 0.8rem; opacity: 0.7; font-weight: 600;">${item.label}</span>
          <button
            type="button"
            class="copy-case-btn"
            data-val="${item.value.replaceAll('"', '&quot;')}"
            style="font-size: 0.75rem; padding: 3px 8px; border-radius: 4px; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer;"
          >
            Copy
          </button>
        </div>
        <div style="font-family: monospace; font-size: 0.9rem; word-break: break-all; color: var(--foreground, #fff);">
          ${item.value || '<span style="opacity: 0.4;">—</span>'}
        </div>
      </div>
    `
      )
      .join('');

    document.querySelectorAll('.copy-case-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const val = (e.target as HTMLElement).dataset.val || '';
        await navigator.clipboard.writeText(val);
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = originalText), 1500);
      });
    });
  }

  caseInput?.addEventListener('input', renderConversions);
  renderConversions();
</script>
