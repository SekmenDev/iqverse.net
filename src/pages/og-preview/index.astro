---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';
---

<ToolLayout
  title="Open Graph & Social Card Previewer"
  subtitle="Preview Social Cards for Google, X, Facebook & LinkedIn"
  pill="BROWSER TOOLS"
  toolSlug="og-preview"
  description="Generate and preview Open Graph (OG), Twitter Card, and Google Search snippets with live social card rendering and HTML tag exporter."
>
  <div style="max-width: 1100px;">
    <section class={sharedStyles.section}>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 20px;">
        <!-- Inputs -->
        <div class={sharedStyles.card}>
          <h3 style="margin: 0 0 16px 0; font-size: 1.1rem;">Meta Tags Input</h3>

          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="ogTitle">
              Page Title (<span id="title-char-count">44</span>/60 chars)
            </label>
            <input
              id="ogTitle"
              type="text"
              value="IQVerse - Free Developer & AI Agent Tools"
              class={sharedStyles.input}
            />
          </div>

          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="ogDesc">
              Meta Description (<span id="desc-char-count">85</span>/160 chars)
            </label>
            <textarea
              id="ogDesc"
              class={sharedStyles.textarea}
              rows="3"
            >Fast, private, client-side browser tools for developers, AI engineers and security researchers.</textarea>
          </div>

          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="ogUrl">
              Canonical URL
            </label>
            <input
              id="ogUrl"
              type="text"
              value="https://iqverse.net"
              class={sharedStyles.input}
            />
          </div>

          <div class={sharedStyles.field}>
            <label class={sharedStyles.fieldLabel} for="ogImg">
              Open Graph Image URL (og:image)
            </label>
            <input
              id="ogImg"
              type="text"
              value="https://iqverse.net/og-banner.png"
              class={sharedStyles.input}
            />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class={sharedStyles.field}>
              <label class={sharedStyles.fieldLabel} for="siteName">
                Site Name
              </label>
              <input
                id="siteName"
                type="text"
                value="IQVerse"
                class={sharedStyles.input}
              />
            </div>
            <div class={sharedStyles.field}>
              <label class={sharedStyles.fieldLabel} for="twHandle">
                Twitter Handle
              </label>
              <input
                id="twHandle"
                type="text"
                value="@iqverse"
                class={sharedStyles.input}
              />
            </div>
          </div>
        </div>

        <!-- Social Card Preview -->
        <div class={sharedStyles.card}>
          <div style="display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;">
            <button
              type="button"
              id="btn-platform-google"
              class={`${sharedStyles.button} ${sharedStyles.buttonPrimary}`}
            >
              Google
            </button>
            <button
              type="button"
              id="btn-platform-twitter"
              class={sharedStyles.button}
            >
              Twitter / X
            </button>
            <button
              type="button"
              id="btn-platform-facebook"
              class={sharedStyles.button}
            >
              Facebook
            </button>
            <button
              type="button"
              id="btn-platform-linkedin"
              class={sharedStyles.button}
            >
              LinkedIn
            </button>
          </div>

          <!-- Google Preview -->
          <div
            id="card-google"
            style="padding: 16px; background: #ffffff; color: #202124; border-radius: 8px; font-family: arial, sans-serif;"
          >
            <div id="google-preview-url" style="font-size: 0.85rem; color: #202124; margin-bottom: 2px;">https://iqverse.net</div>
            <div id="google-preview-title" style="font-size: 1.2rem; color: #1a0dab; font-weight: bold; margin-bottom: 4; cursor: pointer;">
              IQVerse - Free Developer & AI Agent Tools
            </div>
            <div id="google-preview-desc" style="font-size: 0.875rem; color: #4d5156; line-height: 1.4;">
              Fast, private, client-side browser tools for developers, AI engineers and security researchers.
            </div>
          </div>

          <!-- Twitter Preview -->
          <div
            id="card-twitter"
            style="border: 1px solid #333; border-radius: 12px; overflow: hidden; background: #000000; color: #ffffff; display: none;"
          >
            <div
              id="tw-preview-img-box"
              style="height: 180px; background: #222 center/cover no-repeat;"
            ></div>
            <div style="padding: 12px;">
              <div id="tw-preview-url" style="font-size: 0.8rem; opacity: 0.6; margin-bottom: 2px;">iqverse.net</div>
              <div id="tw-preview-title" style="font-size: 0.95rem; font-weight: bold; margin-bottom: 4px;">IQVerse - Free Developer Tools</div>
              <div id="tw-preview-desc" style="font-size: 0.85rem; opacity: 0.8; line-height: 1.3;">Description</div>
            </div>
          </div>

          <!-- Facebook Preview -->
          <div
            id="card-facebook"
            style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; background: #f2f3f5; color: #1c1e21; font-family: helvetica, arial, sans-serif; display: none;"
          >
            <div id="fb-preview-img-box" style="height: 180px; background: #ccc center/cover no-repeat;"></div>
            <div style="padding: 12px; background: #f2f3f5;">
              <div id="fb-preview-url" style="font-size: 0.75rem; color: #606770; text-transform: uppercase; margin-bottom: 2px;">IQVERSE.NET</div>
              <div id="fb-preview-title" style="font-size: 1rem; font-weight: bold; color: #1d2129; margin-bottom: 4px;">IQVerse</div>
              <div id="fb-preview-desc" style="font-size: 0.85rem; color: #606770; line-height: 1.3;">Description</div>
            </div>
          </div>

          <!-- LinkedIn Preview -->
          <div
            id="card-linkedin"
            style="border: 1px solid #e0e0e0; border-radius: 4px; overflow: hidden; background: #ffffff; color: #000000; display: none;"
          >
            <div id="li-preview-img-box" style="height: 180px; background: #ddd center/cover no-repeat;"></div>
            <div style="padding: 12px;">
              <div id="li-preview-title" style="font-size: 0.9rem; font-weight: bold; color: rgba(0,0,0,0.9); margin-bottom: 4px;">IQVerse</div>
              <div id="li-preview-url" style="font-size: 0.75rem; color: rgba(0,0,0,0.6);">iqverse.net</div>
            </div>
          </div>

          <!-- Code Output -->
          <div style="margin-top: 24px;" class={sharedStyles.field}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <label class={sharedStyles.fieldLabel} for="metaCodeOutput">
                Generated HTML Meta Tags
              </label>
              <button type="button" id="btn-copy-meta-tags" class={sharedStyles.button}>
                Copy Tags
              </button>
            </div>
            <textarea
              id="metaCodeOutput"
              readonly
              class={sharedStyles.outputArea}
              rows="10"
              style="font-family: monospace;"
            ></textarea>
          </div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  const titleInput = document.getElementById('ogTitle') as HTMLInputElement;
  const descInput = document.getElementById('ogDesc') as HTMLTextAreaElement;
  const urlInput = document.getElementById('ogUrl') as HTMLInputElement;
  const imgInput = document.getElementById('ogImg') as HTMLInputElement;
  const siteNameInput = document.getElementById('siteName') as HTMLInputElement;
  const twHandleInput = document.getElementById('twHandle') as HTMLInputElement;

  const titleCount = document.getElementById('title-char-count');
  const descCount = document.getElementById('desc-char-count');
  const metaOut = document.getElementById('metaCodeOutput') as HTMLTextAreaElement;
  const btnCopy = document.getElementById('btn-copy-meta-tags');

  const btnGoogle = document.getElementById('btn-platform-google');
  const btnTwitter = document.getElementById('btn-platform-twitter');
  const btnFacebook = document.getElementById('btn-platform-facebook');
  const btnLinkedin = document.getElementById('btn-platform-linkedin');

  const cardGoogle = document.getElementById('card-google');
  const cardTwitter = document.getElementById('card-twitter');
  const cardFacebook = document.getElementById('card-facebook');
  const cardLinkedin = document.getElementById('card-linkedin');

  function setPlatform(platform: 'google' | 'twitter' | 'facebook' | 'linkedin') {
    [btnGoogle, btnTwitter, btnFacebook, btnLinkedin].forEach((b) => (b!.className = 'sharedStyles_button'));
    [cardGoogle, cardTwitter, cardFacebook, cardLinkedin].forEach((c) => (c!.style.display = 'none'));

    if (platform === 'google') {
      btnGoogle!.className = 'sharedStyles_button sharedStyles_buttonPrimary button-primary';
      cardGoogle!.style.display = 'block';
    } else if (platform === 'twitter') {
      btnTwitter!.className = 'sharedStyles_button sharedStyles_buttonPrimary button-primary';
      cardTwitter!.style.display = 'block';
    } else if (platform === 'facebook') {
      btnFacebook!.className = 'sharedStyles_button sharedStyles_buttonPrimary button-primary';
      cardFacebook!.style.display = 'block';
    } else {
      btnLinkedin!.className = 'sharedStyles_button sharedStyles_buttonPrimary button-primary';
      cardLinkedin!.style.display = 'block';
    }
  }

  btnGoogle?.addEventListener('click', () => setPlatform('google'));
  btnTwitter?.addEventListener('click', () => setPlatform('twitter'));
  btnFacebook?.addEventListener('click', () => setPlatform('facebook'));
  btnLinkedin?.addEventListener('click', () => setPlatform('linkedin'));

  function update() {
    const title = titleInput?.value.trim() || '';
    const description = descInput?.value.trim() || '';
    const url = urlInput?.value.trim() || '';
    const imageUrl = imgInput?.value.trim() || '';
    const siteName = siteNameInput?.value.trim() || '';
    const twitterHandle = twHandleInput?.value.trim() || '';

    if (titleCount) titleCount.textContent = String(title.length);
    if (descCount) descCount.textContent = String(description.length);

    // Google card
    const gUrl = document.getElementById('google-preview-url');
    const gTitle = document.getElementById('google-preview-title');
    const gDesc = document.getElementById('google-preview-desc');
    if (gUrl) gUrl.textContent = url;
    if (gTitle) gTitle.textContent = title;
    if (gDesc) gDesc.textContent = description;

    // Twitter card
    const twImg = document.getElementById('tw-preview-img-box');
    const twUrl = document.getElementById('tw-preview-url');
    const twTitle = document.getElementById('tw-preview-title');
    const twDesc = document.getElementById('tw-preview-desc');
    if (twImg) twImg.style.backgroundImage = imageUrl ? `url(${imageUrl})` : 'none';
    if (twUrl) twUrl.textContent = url.replace(/https?:\/\//, '');
    if (twTitle) twTitle.textContent = title;
    if (twDesc) twDesc.textContent = description;

    // Facebook card
    const fbImg = document.getElementById('fb-preview-img-box');
    const fbUrl = document.getElementById('fb-preview-url');
    const fbTitle = document.getElementById('fb-preview-title');
    const fbDesc = document.getElementById('fb-preview-desc');
    if (fbImg) fbImg.style.backgroundImage = imageUrl ? `url(${imageUrl})` : 'none';
    if (fbUrl) fbUrl.textContent = url.replace(/https?:\/\//, '').split('/')[0].toUpperCase();
    if (fbTitle) fbTitle.textContent = title;
    if (fbDesc) fbDesc.textContent = description;

    // LinkedIn card
    const liImg = document.getElementById('li-preview-img-box');
    const liTitle = document.getElementById('li-preview-title');
    const liUrl = document.getElementById('li-preview-url');
    if (liImg) liImg.style.backgroundImage = imageUrl ? `url(${imageUrl})` : 'none';
    if (liTitle) liTitle.textContent = title;
    if (liUrl) liUrl.textContent = url.replace(/https?:\/\//, '');

    // Generate Meta HTML
    let html = `<!-- Primary Meta Tags -->\n`;
    html += `<title>${title}</title>\n`;
    html += `<meta name="title" content="${title}">\n`;
    html += `<meta name="description" content="${description}">\n\n`;

    html += `<!-- Open Graph / Facebook -->\n`;
    html += `<meta property="og:type" content="website">\n`;
    html += `<meta property="og:url" content="${url}">\n`;
    html += `<meta property="og:title" content="${title}">\n`;
    html += `<meta property="og:description" content="${description}">\n`;
    if (imageUrl) html += `<meta property="og:image" content="${imageUrl}">\n`;
    if (siteName) html += `<meta property="og:site_name" content="${siteName}">\n\n`;

    html += `<!-- Twitter / X -->\n`;
    html += `<meta property="twitter:card" content="summary_large_image">\n`;
    html += `<meta property="twitter:url" content="${url}">\n`;
    html += `<meta property="twitter:title" content="${title}">\n`;
    html += `<meta property="twitter:description" content="${description}">\n`;
    if (imageUrl) html += `<meta property="twitter:image" content="${imageUrl}">\n`;
    if (twitterHandle) html += `<meta property="twitter:site" content="${twitterHandle}">\n`;

    if (metaOut) metaOut.value = html.trim();
  }

  [titleInput, descInput, urlInput, imgInput, siteNameInput, twHandleInput].forEach((el) => {
    el?.addEventListener('input', update);
  });

  btnCopy?.addEventListener('click', async () => {
    if (metaOut?.value && btnCopy) {
      await navigator.clipboard.writeText(metaOut.value);
      const prev = btnCopy.textContent;
      btnCopy.textContent = 'Copied!';
      setTimeout(() => (btnCopy.textContent = prev), 1500);
    }
  });

  update();
</script>
