---
import ToolLayout from '@/layouts/ToolLayout.astro';
import sharedStyles from '@/styles/shared-tool-styles.module.css';

const DEFAULT_COOKIES = `Set-Cookie: session_id=xyz12345; Path=/; Domain=iqverse.net; Secure; HttpOnly; SameSite=Lax; Max-Age=3600\nSet-Cookie: tracking_id=abc987; Path=/; SameSite=None`;
---

<ToolLayout
  title="Cookie & Set-Cookie Header Inspector"
  subtitle="Inspect Set-Cookie Flags Or View Cookies In Your Browser"
  pill="BROWSER TOOLS"
  toolSlug="cookie-inspector"
  description="Parse HTTP Set-Cookie headers to verify Secure, HttpOnly, SameSite and Partitioned flags, or list the cookies your browser exposes on this site."
>
  <div style="max-width: 1050px;">
    <section class={sharedStyles.section}>
      <div class={sharedStyles.card}>
        <div class="tool-filter-group" id="cookie-mode-pills" style="margin-bottom: 20px;">
          <button type="button" class="filter-pill active cookie-mode-btn" data-mode="header">
            📋 Paste Set-Cookie Header
          </button>
          <button type="button" class="filter-pill cookie-mode-btn" data-mode="browser">
            🌐 Cookies In This Browser
          </button>
        </div>

        <div class={sharedStyles.field} id="cookie-header-panel">
          <label class={sharedStyles.fieldLabel} for="cookieInput">
            Paste Raw Set-Cookie Header(s)
          </label>
          <textarea
            id="cookieInput"
            class={sharedStyles.textarea}
            rows="4"
            placeholder="Set-Cookie: name=value; Path=/; Secure; HttpOnly..."
          >{DEFAULT_COOKIES}</textarea>
        </div>

        <div id="cookie-browser-panel" style="display: none;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div style="font-size: 0.9rem;">
              Cookies readable on <strong id="cookie-host">this page</strong>:
              <strong id="cookie-browser-total">0</strong> cookie(s), <strong id="cookie-browser-bytes">0</strong> bytes.
            </div>
            <button type="button" id="btn-refresh-cookies" class={`${sharedStyles.button} ${sharedStyles.buttonSmall}`}>
              ↻ Refresh
            </button>
          </div>
          <div style="margin-top: 12px; padding: 10px 14px; border-radius: 6px; background: rgba(33, 150, 243, 0.08); border: 1px solid rgba(33, 150, 243, 0.3); font-size: 0.85rem;">
            This reads <code>document.cookie</code> for the current site only. HttpOnly cookies are invisible to
            JavaScript by design, so they never appear here. Nothing is uploaded or stored.
          </div>
        </div>

        <div style="margin-top: 24px;">
          <h3 style="margin: 0 0 14px 0; font-size: 1.1rem;">
            Parsed Cookie Directives
          </h3>

          <div class="tool-filter-bar" style="margin-top: 0;">
            <div class="tool-filter-group" id="cookie-filter-pills">
              <button type="button" class="filter-pill active cookie-filter-btn" data-filter="all">
                All Cookies <span class="filter-badge" id="cookie-count-all">0</span>
              </button>
              <button type="button" class="filter-pill cookie-filter-btn" data-filter="secure" id="cookie-pill-secure">
                🔒 Secure <span class="filter-badge" id="cookie-count-sec">0</span>
              </button>
              <button type="button" class="filter-pill cookie-filter-btn" data-filter="httponly" id="cookie-pill-httponly">
                🛡️ HttpOnly <span class="filter-badge" id="cookie-count-http">0</span>
              </button>
              <button type="button" class="filter-pill filter-pill-danger cookie-filter-btn" data-filter="warnings">
                ⚠️ With Warnings <span class="filter-badge" id="cookie-count-warn">0</span>
              </button>
            </div>

            <div class="search-input-wrap">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                id="cookie-search-input"
                type="text"
                class="tool-search-input"
                placeholder="Search cookie name, domain, path..."
              />
              <button type="button" id="btn-clear-cookie-search" class="search-clear-btn" title="Clear search">✕</button>
            </div>
          </div>

          <div class="table-results-counter">
            <span>Showing <strong id="cookie-visible-count">0</strong> of <span id="cookie-total-count">0</span> cookies</span>
          </div>

          <div id="cookies-list" style="display: flex; flex-direction: column; gap: 16px;"></div>

          <div id="cookie-empty-state" class="tool-empty-state" style="display: none;">
            <div class="tool-empty-state-icon">🔍</div>
            <div class="tool-empty-state-title" id="cookie-empty-title">No matching cookies</div>
            <div class="tool-empty-state-text" id="cookie-empty-text">
              Try adjusting your search query or switching the active filter.
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { parseSetCookieHeader, readBrowserCookies, type ParsedCookie } from '@/lib/cookies';

  const cookieInput = document.getElementById('cookieInput') as HTMLTextAreaElement;
  const headerPanel = document.getElementById('cookie-header-panel');
  const browserPanel = document.getElementById('cookie-browser-panel');
  const hostEl = document.getElementById('cookie-host');
  const browserTotalEl = document.getElementById('cookie-browser-total');
  const browserBytesEl = document.getElementById('cookie-browser-bytes');
  const btnRefresh = document.getElementById('btn-refresh-cookies');
  const pillSecure = document.getElementById('cookie-pill-secure');
  const pillHttpOnly = document.getElementById('cookie-pill-httponly');
  const emptyTitleEl = document.getElementById('cookie-empty-title');
  const emptyTextEl = document.getElementById('cookie-empty-text');
  const cookiesList = document.getElementById('cookies-list');
  const searchInput = document.getElementById('cookie-search-input') as HTMLInputElement;
  const btnClearSearch = document.getElementById('btn-clear-cookie-search');
  const emptyState = document.getElementById('cookie-empty-state');
  const visibleCountEl = document.getElementById('cookie-visible-count');
  const totalCountEl = document.getElementById('cookie-total-count');

  const countAllEl = document.getElementById('cookie-count-all');
  const countSecEl = document.getElementById('cookie-count-sec');
  const countHttpEl = document.getElementById('cookie-count-http');
  const countWarnEl = document.getElementById('cookie-count-warn');

  const filterBtns = document.querySelectorAll('.cookie-filter-btn');
  const modeBtns = document.querySelectorAll('.cookie-mode-btn');
  let activeFilter = 'all';
  let activeMode: 'header' | 'browser' = 'header';

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function resetFilter() {
    activeFilter = 'all';
    filterBtns.forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.filter === 'all'));
  }

  modeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = (btn as HTMLElement).dataset.mode === 'browser' ? 'browser' : 'header';
      if (mode === activeMode) return;

      activeMode = mode;
      modeBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const browserMode = activeMode === 'browser';
      if (headerPanel) headerPanel.style.display = browserMode ? 'none' : '';
      if (browserPanel) browserPanel.style.display = browserMode ? 'block' : 'none';
      if (pillSecure) pillSecure.style.display = browserMode ? 'none' : '';
      if (pillHttpOnly) pillHttpOnly.style.display = browserMode ? 'none' : '';
      if (hostEl) hostEl.textContent = window.location.hostname;

      resetFilter();
      render();
    });
  });

  btnRefresh?.addEventListener('click', render);

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = (btn as HTMLElement).dataset.filter || 'all';
      render();
    });
  });

  searchInput?.addEventListener('input', () => {
    if (btnClearSearch) btnClearSearch.style.display = searchInput.value ? 'inline-block' : 'none';
    render();
  });

  btnClearSearch?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      btnClearSearch.style.display = 'none';
      render();
      searchInput.focus();
    }
  });

  function render() {
    if (!cookiesList) return;

    const allCookies: ParsedCookie[] =
      activeMode === 'browser' ? readBrowserCookies() : parseSetCookieHeader(cookieInput?.value || '') || [];
    const query = (searchInput?.value || '').toLowerCase().trim();

    if (activeMode === 'browser') {
      const totalBytes = allCookies.reduce((sum, c) => sum + c.size, 0);
      if (browserTotalEl) browserTotalEl.textContent = String(allCookies.length);
      if (browserBytesEl) browserBytesEl.textContent = String(totalBytes);
    }

    const secCount = allCookies.filter((c) => c.secure).length;
    const httpCount = allCookies.filter((c) => c.httpOnly).length;
    const warnCount = allCookies.filter((c) => c.warnings.length > 0).length;

    if (countAllEl) countAllEl.textContent = String(allCookies.length);
    if (countSecEl) countSecEl.textContent = String(secCount);
    if (countHttpEl) countHttpEl.textContent = String(httpCount);
    if (countWarnEl) countWarnEl.textContent = String(warnCount);

    if (totalCountEl) totalCountEl.textContent = String(allCookies.length);

    const filtered = allCookies.filter((cookie) => {
      if (activeFilter === 'secure' && !cookie.secure) return false;
      if (activeFilter === 'httponly' && !cookie.httpOnly) return false;
      if (activeFilter === 'warnings' && cookie.warnings.length === 0) return false;

      if (query) {
        const matchesName = cookie.name.toLowerCase().includes(query);
        const matchesVal = cookie.value.toLowerCase().includes(query);
        const matchesDom = (cookie.domain || '').toLowerCase().includes(query);
        const matchesPath = (cookie.path || '').toLowerCase().includes(query);
        if (!matchesName && !matchesVal && !matchesDom && !matchesPath) {
          return false;
        }
      }
      return true;
    });

    if (visibleCountEl) visibleCountEl.textContent = String(filtered.length);

    if (filtered.length === 0) {
      cookiesList.innerHTML = '';
      const noneAtAll = allCookies.length === 0;
      if (emptyTitleEl) {
        emptyTitleEl.textContent =
          noneAtAll && activeMode === 'browser' ? 'No readable cookies on this site' : 'No matching cookies';
      }
      if (emptyTextEl) {
        emptyTextEl.textContent =
          noneAtAll && activeMode === 'browser'
            ? 'This page has no cookies that JavaScript can read. HttpOnly cookies stay hidden from this view.'
            : 'Try adjusting your search query or switching the active filter.';
      }
      if (emptyState) emptyState.style.display = 'flex';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';

    cookiesList.innerHTML = filtered
      .map((cookie) => {
        const fromBrowser = cookie.source === 'browser';
        const flags = fromBrowser
          ? `<span style="padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; background: rgba(255, 255, 255, 0.1); color: #888;">
               Readable by JavaScript
             </span>`
          : `<span
              style="padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; background: ${
                cookie.httpOnly ? 'rgba(76, 175, 80, 0.2)' : 'rgba(255, 255, 255, 0.1)'
              }; color: ${cookie.httpOnly ? '#4caf50' : '#888'};"
            >
              HttpOnly: ${cookie.httpOnly ? 'Yes' : 'No'}
            </span>
            <span
              style="padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; background: ${
                cookie.secure ? 'rgba(76, 175, 80, 0.2)' : 'rgba(255, 255, 255, 0.1)'
              }; color: ${cookie.secure ? '#4caf50' : '#888'};"
            >
              Secure: ${cookie.secure ? 'Yes' : 'No'}
            </span>`;

        const details = fromBrowser
          ? `<div>Domain: <strong>${escapeHtml(cookie.domain || 'Unspecified')}</strong></div>
             <div>Size: <strong>${cookie.size} bytes</strong></div>
             <div>HttpOnly: <strong>No</strong></div>
             <div>Secure: <strong>Not exposed to JavaScript</strong></div>`
          : `<div>Domain: <strong>${escapeHtml(cookie.domain || 'Unspecified')}</strong></div>
             <div>Path: <strong>${escapeHtml(cookie.path || '/')}</strong></div>
             <div>SameSite: <strong>${escapeHtml(cookie.sameSite || 'Default (Lax)')}</strong></div>
             <div>Max-Age: <strong>${escapeHtml(String(cookie.maxAge ?? 'Session'))}</strong></div>`;

        return `
      <div
        style="padding: 16px; border-radius: 8px; background: rgba(255, 255, 255, 0.02); border: 1px solid ${
          cookie.warnings.length === 0 ? 'var(--border)' : '#faad14'
        };"
      >
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
          <div style="min-width: 0; word-break: break-all;">
            <strong style="font-size: 1.1rem; color: #2196f3;">${escapeHtml(cookie.name)}</strong> =
            <code style="font-family: monospace;">${escapeHtml(cookie.value)}</code>
          </div>
          <div style="display: flex; gap: 8px;">
            ${flags}
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; font-size: 0.85rem;">
          ${details}
        </div>

        ${
          cookie.warnings.length > 0
            ? `
          <div style="margin-top: 12px; padding: 8px 12px; border-radius: 4px; background: rgba(250, 173, 20, 0.1); border: 1px solid rgba(250, 173, 20, 0.3); color: #faad14; font-size: 0.85rem;">
            <strong>Security Warnings:</strong>
            <ul style="margin: 4px 0 0 16px; padding: 0;">
              ${cookie.warnings.map((w) => `<li>${escapeHtml(w)}</li>`).join('')}
            </ul>
          </div>
        `
            : ''
        }
      </div>
    `;
      })
      .join('');
  }

  cookieInput?.addEventListener('input', render);
  render();
</script>
